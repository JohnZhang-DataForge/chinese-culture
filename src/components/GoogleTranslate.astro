---
import { GOOGLE_TRANSLATE_LANGUAGES } from "../lib/google-translate-url.js";
---

<div class="google-translate-widget">
  <label class="visually-hidden" for="google-translate-language">Translate this page</label>
  <select id="google-translate-language" name="google-translate-language" aria-label="Select Language">
    <option value="" selected>Select Language</option>
    {GOOGLE_TRANSLATE_LANGUAGES.map(({ code, label }) => <option value={code}>{label}</option>)}
  </select>
  <a class="google-translate-credit" href="https://translate.google.com/" target="_blank" rel="noopener noreferrer">
    Powered by <span>Google</span> Translate
  </a>
</div>

<script>
  import { buildGoogleTranslateUrl } from "../lib/google-translate-url.js";

  const languageSelector = document.querySelector("#google-translate-language");

  if (languageSelector instanceof HTMLSelectElement) {
    languageSelector.addEventListener("change", () => {
      const targetLanguage = languageSelector.value;
      if (!targetLanguage) return;

      window.location.assign(
        buildGoogleTranslateUrl(window.location.href, targetLanguage)
      );
    });
  }
</script>

<style>
  .google-translate-widget {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.12rem;
    width: 150px;
    min-width: 0;
  }

  .google-translate-widget select {
    width: 100%;
    min-height: 29px;
    padding: 0.25rem 1.5rem 0.25rem 0.45rem;
    border: 1px solid #c9c3b8;
    border-radius: 3px;
    background: #fcfaf6;
    color: #252b2a;
    font: 0.72rem/1.35 var(--sans);
  }

  .google-translate-widget select:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }

  .google-translate-credit {
    color: #777a74;
    font: 0.57rem/1.2 var(--sans);
    text-decoration: none;
    white-space: nowrap;
  }

  .google-translate-credit:hover {
    color: var(--red);
  }

  .google-translate-credit span {
    color: #4285f4;
    font-weight: 700;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    :global(.header-inner) {
      flex-wrap: wrap;
      row-gap: 0.55rem;
      padding-block: 0.6rem;
    }

    .google-translate-widget {
      flex: 1 0 100%;
      width: 100%;
      padding-bottom: 0.2rem;
    }

    .google-translate-widget select {
      width: min(100%, 220px);
    }
  }
</style>
