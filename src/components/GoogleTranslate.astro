<div class="google-translate-widget" aria-label="網頁翻譯">
  <span class="translate-label">翻譯此頁</span>
  <div id="google_translate_element"></div>
  <noscript><span class="translate-fallback">請使用瀏覽器內建翻譯功能。</span></noscript>
  <span class="translate-fallback">若翻譯選單無法載入，請使用瀏覽器內建翻譯功能。</span>
</div>
<script is:inline>
  window.googleTranslateElementInit = function () {
    if (!window.google || !window.google.translate || !window.google.translate.TranslateElement) return;
    new window.google.translate.TranslateElement({
      pageLanguage: "zh-TW",
      autoDisplay: false,
      layout: window.google.translate.TranslateElement.InlineLayout.SIMPLE
    }, "google_translate_element");
  };
</script>
<script is:inline src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
<style>
  .google-translate-widget{display:flex;align-items:center;gap:.45rem;min-width:0;color:#514a40;font:.72rem/1.3 var(--sans)}
  .translate-label{white-space:nowrap}
  #google_translate_element{min-width:0}
  :global(.goog-te-gadget){font:inherit!important;color:inherit!important}
  :global(.goog-te-gadget .goog-te-combo){max-width:150px;min-height:30px;margin:0!important;padding:.25rem .4rem;border:1px solid #c9c3b8;border-radius:4px;background:#fcfaf6;color:#252b2a;font:inherit}
  .translate-fallback{font-size:.62rem;color:#777;max-width:220px}
  @media(max-width:760px){.google-translate-widget{flex:1 0 100%;padding:.2rem 0 .35rem;flex-wrap:wrap}}
</style>
