---
import "../styles/global.css";
import "../styles/no-photo.css";
import "../styles/editorial-refresh.css";
import { ui } from "../i18n/site";
import GoogleTranslate from "../components/GoogleTranslate.astro";
const { title = "Discover Chinese culture", description = "以繁體中文認識中國文化、節慶、藝術、文學與日常生活。" } = Astro.props;
const labels = ui["zh-tw"];
const pageTitle = title === "Discover Chinese culture" ? "中國文化地圖 — 探索、學習、感受" : title + " | 中國文化地圖";
const nav = ["learn","culture","festivals","books","events"].map((route,index)=>({href:"/zh-tw/"+route+"/",label:labels.nav[index]}));
---
<!doctype html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#e60012" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <title>{pageTitle}</title>
  <link rel="canonical" href={"https://chinese-culture.site" + Astro.url.pathname} />
  <link rel="alternate" hreflang="zh-TW" href={"https://chinese-culture.site" + Astro.url.pathname} />
  <link rel="alternate" hreflang="x-default" href={"https://chinese-culture.site" + Astro.url.pathname} />
</head>
<body class="culture-playful">
  <a class="skip-link" href="#main-content">{labels.skip}</a>
  <div class="top-ribbon"><div class="wrap"><span>文化 CHINESE CULTURE ATLAS</span><span>探索 · 學習 · 慶祝</span><span>為好奇的心靈而創</span></div></div>
  <header class="site-header"><div class="wrap header-inner">
    <a href="/zh-tw/" class="brand" aria-label="中國文化地圖首頁"><span class="brand-symbol" aria-hidden="true">文</span><span class="brand-type"><span class="brand-kicker">探索世界的窗口</span><strong>CHINESE CULTURE <span>ATLAS</span></strong></span></a>
    <nav class="desktop-nav" aria-label="主要導覽">{nav.slice(0,4).map((n)=><a href={n.href} aria-current={Astro.url.pathname.startsWith(n.href)?"page":undefined}>{n.label}</a>)}</nav>
    <details class="mobile-nav"><summary>{labels.explore} <span aria-hidden="true">☰</span></summary><nav aria-label="行動版導覽">{nav.map((n)=><a href={n.href}>{n.label}</a>)}<a href="/zh-tw/about/">{labels.about}</a></nav></details>
    <div class="header-tools"><a class="header-about" href="/zh-tw/about/">{labels.about}</a><GoogleTranslate /></div>
  </div></header>
  <main id="main-content"><slot /></main>
  <footer class="site-footer"><div class="wrap footer-top">
    <div><span class="footer-mark" aria-hidden="true">文化</span><p class="footer-title">{labels.footerTitle}</p><p class="footer-note">{labels.footerNote}</p></div>
    <div class="footer-links"><div><span class="footer-label">{labels.exploreLabel}</span>{nav.map((n)=><a href={n.href}>{n.label}</a>)}</div><div><span class="footer-label">{labels.projectLabel}</span><a href="/zh-tw/about/">{labels.approach}</a><a href="/zh-tw/editorial-policy/">{labels.editorial}</a><a href="/zh-tw/privacy/">{labels.privacy}</a><a href="/zh-tw/accessibility/">{labels.accessibility}</a></div></div>
  </div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} Chinese Culture Atlas</span><span>{labels.footerBottom}</span></div></footer>
</body>
</html>
