---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const [lessons, culture, festivals, books] = await Promise.all([
  getCollection("lessons"),
  getCollection("culture"),
  getCollection("festivals"),
  getCollection("books")
]);

const stories = [
  ...lessons.map((entry) => ({ entry, href: "/learn/" + entry.id + "/", section: "LEARN" })),
  ...culture.map((entry) => ({ entry, href: "/culture/" + entry.id + "/", section: "CULTURE" })),
  ...festivals.map((entry) => ({ entry, href: "/festivals/" + entry.id + "/", section: "FESTIVALS" })),
  ...books.map((entry) => ({ entry, href: "/books/" + entry.id + "/", section: "BOOKS" }))
].sort((a, b) => Number(b.entry.data.featured) - Number(a.entry.data.featured));

const featuredStory = stories.find((story) => story.entry.data.featured && story.entry.data.image) ?? stories.find((story) => story.entry.data.image);
const otherStories = stories.filter((story) => story !== featuredStory && story.entry.data.image);
const latestStories = otherStories.slice(0, 8);
const moreStories = otherStories.slice(8);
---
<BaseLayout>
  <div class="image-led-home">
    {featuredStory && <section class="top-feature" aria-label="Featured article">
      <a class="top-feature-link" href={featuredStory.href}>
        <img class="top-feature-photo" src={featuredStory.entry.data.image} alt={featuredStory.entry.data.imageAlt ?? featuredStory.entry.data.title} fetchpriority="high" />
        <span class="top-feature-overlay"></span>
        <span class="top-feature-content">
          <span class="feature-label"><i></i> FEATURED STORY · {featuredStory.section}</span>
          <span class="top-feature-title">{featuredStory.entry.data.title}</span>
          <span class="top-feature-description">{featuredStory.entry.data.description}</span>
          <span class="feature-read">Read the story <b>↗</b></span>
        </span>
        <span class="top-feature-count">01 <i></i> FEATURED</span>
      </a>
    </section>}

    <section class="home-news wrap">
      <div class="news-heading">
        <div><span class="section-kicker">FRESH FROM THE CULTURE ATLAS</span><h2>Discover something new</h2><p>Stories, traditions and ideas worth exploring.</p></div>
        <a class="all-link" href="/culture/">Explore all stories <span>→</span></a>
      </div>
      <div class="news-grid">
        {latestStories.map((story, index) => <a class="news-card" href={story.href}>
          <div class="news-card-photo"><img src={story.entry.data.image} alt={story.entry.data.imageAlt ?? story.entry.data.title} loading="lazy" /><span class="news-card-number">{String(index + 2).padStart(2, "0")}</span></div>
          <div class="news-card-copy"><span class="news-card-category">{story.section}</span><h3>{story.entry.data.title}</h3><p>{story.entry.data.description}</p><span class="news-card-read">Read article <b>↗</b></span></div>
        </a>)}
      </div>
    </section>

    <section class="visual-topics">
      <div class="wrap">
        <div class="news-heading"><div><span class="section-kicker">FIND YOUR NEXT ADVENTURE</span><h2>Explore the world of Chinese culture</h2><p>Pick a topic and follow your curiosity.</p></div></div>
        <div class="visual-topic-grid">
          <a href="/culture/" class="visual-topic topic-art"><span>01 / CULTURE</span><strong>Arts &amp; traditions</strong><b>Explore ↗</b></a>
          <a href="/festivals/" class="visual-topic topic-festival"><span>02 / FESTIVALS</span><strong>Celebrate together</strong><b>Explore ↗</b></a>
          <a href="/learn/" class="visual-topic topic-learn"><span>03 / LEARNING</span><strong>Start discovering</strong><b>Explore ↗</b></a>
          <a href="/books/" class="visual-topic topic-books"><span>04 / BOOKS</span><strong>Stories &amp; ideas</strong><b>Explore ↗</b></a>
        </div>
      </div>
    </section>

    {moreStories.length > 0 && <section class="home-news wrap more-stories">
      <div class="news-heading"><div><span class="section-kicker">KEEP EXPLORING</span><h2>More stories to discover</h2><p>There is always another story waiting around the corner.</p></div></div>
      <div class="news-grid">
        {moreStories.map((story, index) => <a class="news-card" href={story.href}>
          <div class="news-card-photo"><img src={story.entry.data.image} alt={story.entry.data.imageAlt ?? story.entry.data.title} loading="lazy" /><span class="news-card-number">{String(index + 10).padStart(2, "0")}</span></div>
          <div class="news-card-copy"><span class="news-card-category">{story.section}</span><h3>{story.entry.data.title}</h3><p>{story.entry.data.description}</p><span class="news-card-read">Read article <b>↗</b></span></div>
        </a>)}
      </div>
    </section>}

    <section class="home-bottom-callout">
      <div class="wrap"><span class="callout-chinese">文化</span><div><span class="section-kicker">CHINESE CULTURE ATLAS</span><h2>A world of stories is waiting.</h2><p>Explore with curiosity. Discover with context. Share what you learn.</p></div><a class="pill-button pill-white" href="/about/">About the project <span>→</span></a></div>
    </section>
  </div>
</BaseLayout>
