---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const [lessons, culture, festivals, books] = await Promise.all([
  getCollection("lessons"),
  getCollection("culture"),
  getCollection("festivals"),
  getCollection("books")
]);

const stories = [
  ...lessons.map((entry) => ({ entry, href: "/learn/" + entry.id + "/", section: "LEARN" })),
  ...culture.map((entry) => ({ entry, href: "/culture/" + entry.id + "/", section: "CULTURE" })),
  ...festivals.map((entry) => ({ entry, href: "/festivals/" + entry.id + "/", section: "FESTIVALS" })),
  ...books.map((entry) => ({ entry, href: "/books/" + entry.id + "/", section: "BOOKS" }))
].filter((story) => story.entry.data.image)
 .sort((a, b) => Number(b.entry.data.featured) - Number(a.entry.data.featured));

const featuredStories = stories.filter((story) => story.entry.data.featured).slice(0, 5);
const heroStories = featuredStories.length ? featuredStories : stories.slice(0, 3);
const heroIds = new Set(heroStories.map((story) => story.href));
const feedStories = stories.filter((story) => !heroIds.has(story.href));
const latestStories = feedStories.slice(0, 8);
const moreStories = feedStories.slice(8);
const fallbackBySection = {
  LEARN: "https://images.unsplash.com/photo-1753863580173-e292f00beeed?auto=format&fit=crop&w=1400&q=85",
  CULTURE: "https://images.unsplash.com/photo-1747479332454-f2f9420556b8?auto=format&fit=crop&w=1400&q=85",
  FESTIVALS: "https://images.unsplash.com/photo-1549163950-d16f273c8960?auto=format&fit=crop&w=1400&q=85",
  BOOKS: "https://images.unsplash.com/photo-1648769170333-fd01106d8873?auto=format&fit=crop&w=1400&q=85"
};
---
<BaseLayout>
  <div class="image-led-home">
    <section class="feature-carousel" aria-label="Featured articles" data-feature-carousel>
      <div class="feature-slides">
        {heroStories.map((story, index) => <a class:list={["feature-slide", index === 0 && "is-active"]} href={story.href} data-feature-slide={index} aria-hidden={index === 0 ? "false" : "true"} tabindex={index === 0 ? 0 : -1}>
          <img class="feature-slide-photo" src={story.entry.data.image} alt={story.entry.data.imageAlt ?? story.entry.data.title} fetchpriority={index === 0 ? "high" : "auto"} loading={index === 0 ? "eager" : "lazy"} data-fallback={fallbackBySection[story.section]} />
          <span class="feature-slide-shade"></span>
          <span class="feature-slide-content">
            <span class="feature-label"><i></i> FEATURED STORY <b>· {story.section}</b></span>
            <span class="feature-slide-title">{story.entry.data.title}</span>
            <span class="feature-slide-description">{story.entry.data.description}</span>
            <span class="feature-slide-cta">Read the article <b>↗</b></span>
          </span>
          <span class="feature-slide-count">{String(index + 1).padStart(2, "0")} <i></i> {String(heroStories.length).padStart(2, "0")}</span>
        </a>)}
      </div>
      {heroStories.length > 1 && <div class="feature-controls" aria-label="Featured article controls">
        <button class="feature-arrow feature-prev" type="button" aria-label="Previous featured article">←</button>
        <div class="feature-dots" role="group" aria-label="Choose featured article">
          {heroStories.map((story, index) => <button class:list={["feature-dot", index === 0 && "is-active"]} type="button" data-feature-dot={index} aria-label={"Show featured article " + (index + 1) + ": " + story.entry.data.title} aria-pressed={index === 0 ? "true" : "false"}></button>)}
        </div>
        <button class="feature-arrow feature-next" type="button" aria-label="Next featured article">→</button>
        <span class="feature-auto-label">AUTO PLAY</span>
      </div>}
    </section>

    <section class="home-news wrap">
      <div class="news-heading">
        <div><span class="section-kicker">FRESH FROM THE CULTURE ATLAS</span><h2>Discover something new</h2><p>Stories, traditions and ideas worth exploring.</p></div>
        <a class="all-link" href="/culture/">Explore all stories <span>→</span></a>
      </div>
      <div class="news-grid">
        {latestStories.map((story, index) => <a class="news-card" href={story.href}>
          <div class="news-card-photo" style={"--card-fallback: url('" + fallbackBySection[story.section] + "')"}>
            <img src={story.entry.data.image} alt={story.entry.data.imageAlt ?? story.entry.data.title} loading={index < 4 ? "eager" : "lazy"} data-fallback={fallbackBySection[story.section]} />
            <span class="news-card-number">{String(index + 1).padStart(2, "0")}</span>
          </div>
          <div class="news-card-copy"><span class="news-card-category">{story.section}</span><h3>{story.entry.data.title}</h3><p>{story.entry.data.description}</p><span class="news-card-read">Read article <b>↗</b></span></div>
        </a>)}
      </div>
    </section>

    <section class="visual-topics">
      <div class="wrap">
        <div class="news-heading"><div><span class="section-kicker">FIND YOUR NEXT ADVENTURE</span><h2>Explore the world of Chinese culture</h2><p>Pick a topic and follow your curiosity.</p></div></div>
        <div class="visual-topic-grid">
          <a href="/culture/" class="visual-topic topic-art"><img src="https://images.unsplash.com/photo-1753863580173-e292f00beeed?auto=format&fit=crop&w=1000&q=85" data-fallback="https://images.unsplash.com/photo-1455390582262-044c871b6f4c?auto=format&fit=crop&w=1000&q=85" alt="" aria-hidden="true" loading="lazy" /><span>01 / CULTURE</span><strong>Arts &amp; traditions</strong><b>Explore ↗</b></a>
          <a href="/festivals/" class="visual-topic topic-festival"><img src="https://images.unsplash.com/photo-1772764058009-e6cb2203d773?auto=format&fit=crop&w=1000&q=85" data-fallback="https://upload.wikimedia.org/wikipedia/commons/5/55/Red_lanterns%2C_Spring_Festival%2C_Ditan_Park_Beijing.JPG" alt="" aria-hidden="true" loading="lazy" /><span>02 / FESTIVALS</span><strong>Celebrate together</strong><b>Explore ↗</b></a>
          <a href="/learn/" class="visual-topic topic-learn"><img src="https://images.unsplash.com/photo-1744699013747-090188297e5e?auto=format&fit=crop&w=1000&q=85" data-fallback="https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=1000&q=85" alt="" aria-hidden="true" loading="lazy" /><span>03 / LEARNING</span><strong>Start discovering</strong><b>Explore ↗</b></a>
          <a href="/books/" class="visual-topic topic-books"><img src="https://images.unsplash.com/photo-1763225037262-75d0cb46f9c2?auto=format&fit=crop&w=1000&q=85" data-fallback="https://images.unsplash.com/photo-1648769170333-fd01106d8873?auto=format&fit=crop&w=1000&q=85" alt="" aria-hidden="true" loading="lazy" /><span>04 / BOOKS</span><strong>Stories &amp; ideas</strong><b>Explore ↗</b></a>
        </div>
      </div>
    </section>

    {moreStories.length > 0 && <section class="home-news wrap more-stories">
      <div class="news-heading"><div><span class="section-kicker">KEEP EXPLORING</span><h2>More stories to discover</h2><p>There is always another story waiting around the corner.</p></div></div>
      <div class="news-grid">
        {moreStories.map((story, index) => <a class="news-card" href={story.href}>
          <div class="news-card-photo" style={"--card-fallback: url('" + fallbackBySection[story.section] + "')"}>
            <img src={story.entry.data.image} alt={story.entry.data.imageAlt ?? story.entry.data.title} loading="lazy" data-fallback={fallbackBySection[story.section]} />
            <span class="news-card-number">{String(index + 9).padStart(2, "0")}</span>
          </div>
          <div class="news-card-copy"><span class="news-card-category">{story.section}</span><h3>{story.entry.data.title}</h3><p>{story.entry.data.description}</p><span class="news-card-read">Read article <b>↗</b></span></div>
        </a>)}
      </div>
    </section>}

    <section class="home-bottom-callout">
      <div class="wrap"><span class="callout-chinese">文化</span><div><span class="section-kicker">CHINESE CULTURE ATLAS</span><h2>A world of stories is waiting.</h2><p>Explore with curiosity. Discover with context. Share what you learn.</p></div><a class="pill-button pill-white" href="/about/">About the project <span>→</span></a></div>
    </section>
  </div>
  <script>
    const carousel = document.querySelector("[data-feature-carousel]");
    if (carousel) {
      const slides = Array.from(carousel.querySelectorAll("[data-feature-slide]"));
      const dots = Array.from(carousel.querySelectorAll("[data-feature-dot]"));
      const previous = carousel.querySelector(".feature-prev");
      const next = carousel.querySelector(".feature-next");
      let activeIndex = 0;
      let timer;
      let paused = false;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const show = (index) => {
        activeIndex = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === activeIndex;
          slide.classList.toggle("is-active", active);
          slide.setAttribute("aria-hidden", String(!active));
          slide.setAttribute("tabindex", active ? "0" : "-1");
        });
        dots.forEach((dot, i) => {
          const active = i === activeIndex;
          dot.classList.toggle("is-active", active);
          dot.setAttribute("aria-pressed", String(active));
        });
      };
      const stop = () => window.clearInterval(timer);
      const start = () => {
        stop();
        if (!reduceMotion && slides.length > 1 && !paused && !document.hidden) {
          timer = window.setInterval(() => show(activeIndex + 1), 6500);
        }
      };
      previous?.addEventListener("click", () => { show(activeIndex - 1); start(); });
      next?.addEventListener("click", () => { show(activeIndex + 1); start(); });
      dots.forEach((dot) => dot.addEventListener("click", () => { show(Number(dot.dataset.featureDot)); start(); }));
      carousel.addEventListener("mouseenter", () => { paused = true; stop(); });
      carousel.addEventListener("mouseleave", () => { paused = false; start(); });
      carousel.addEventListener("focusin", () => { paused = true; stop(); });
      carousel.addEventListener("focusout", (event) => { if (!carousel.contains(event.relatedTarget)) { paused = false; start(); } });
      document.addEventListener("visibilitychange", start);
      carousel.querySelectorAll("img[data-fallback]").forEach((img) => {
        img.addEventListener("error", () => {
          const fallback = img.dataset.fallback;
          if (fallback && img.src !== fallback) {
            img.src = fallback;
            img.dataset.fallback = "";
          } else {
            img.closest(".news-card-photo")?.classList.add("image-unavailable");
            img.closest(".feature-slide")?.classList.add("image-unavailable");
            img.remove();
          }
        });
      });
      start();
    }
    document.querySelectorAll(".visual-topic img[data-fallback]").forEach((img) => {
      img.addEventListener("error", () => {
        const fallback = img.dataset.fallback;
        if (fallback && img.src !== fallback) {
          img.src = fallback;
          img.dataset.fallback = "";
        } else {
          img.closest(".visual-topic")?.classList.add("image-unavailable");
          img.remove();
        }
      });
    });
  </script>
</BaseLayout>
