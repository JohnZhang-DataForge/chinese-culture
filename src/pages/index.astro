---
import BaseLayout from "../layouts/BaseLayout.astro";
import StoryCard from "../components/StoryCard.astro";
import { getCollection } from "astro:content";

const lessons = (await getCollection("lessons")).sort((a,b)=>(a.data.order??99)-(b.data.order??99)).slice(0,3);
const traditions = (await getCollection("culture")).slice(0,4);
const festivals = (await getCollection("festivals")).slice(0,2);
const books = (await getCollection("books")).slice(0,2);
const featuredFestival = festivals[0];
---
<BaseLayout>
  <div class="playful-home">
    <section class="welcome-banner">
      <div class="welcome-inner">
        <div class="welcome-copy">
          <span class="home-kicker"><span class="kicker-dot"></span> YOUR ADVENTURE STARTS HERE</span>
          <h1>A whole world<br />of <em>Chinese culture</em><br />to discover!</h1>
          <p>Explore traditions, stories, celebrations, art and ideas — one fascinating discovery at a time.</p>
          <div class="welcome-actions">
            <a class="pill-button pill-white" href="/learn/">Start exploring <span>→</span></a>
            <a class="welcome-link" href="/culture/">Browse the culture library</a>
          </div>
          <div class="welcome-pagination" aria-label="Featured collection"><span class="page-dot active"></span><span class="page-dot"></span><span class="page-dot"></span><small>01 / 03 · DISCOVER SOMETHING NEW</small></div>
        </div>
        <div class="welcome-art" role="img" aria-label="Illustrated Chinese-inspired landscape with mountains, sun and a traditional pavilion">
          <div class="art-sun"></div><div class="art-cloud cloud-one"></div><div class="art-cloud cloud-two"></div>
          <div class="art-mountain mountain-back"></div><div class="art-mountain mountain-front"></div>
          <div class="art-water"></div><div class="art-pavilion"><span></span><i></i></div>
          <div class="art-label">山水之间<br/><small>BETWEEN MOUNTAINS &amp; WATER</small></div>
          <span class="art-floating art-flower">✿</span><span class="art-floating art-bird">⌁</span>
        </div>
        <span class="welcome-decoration decoration-one">福</span><span class="welcome-decoration decoration-two">春</span>
      </div>
    </section>

    <section class="quick-explore wrap">
      <div class="section-title-row"><div><span class="section-kicker">PICK YOUR PATH</span><h2>Where will curiosity take you?</h2></div><a class="all-link" href="/culture/">Explore everything <span>→</span></a></div>
      <div class="category-grid">
        <a class="category-card category-coral" href="/culture/"><span class="category-emoji">🎨</span><strong>Arts &amp; culture</strong><small>Art, craft and everyday life</small><span class="category-arrow">↗</span></a>
        <a class="category-card category-gold" href="/festivals/"><span class="category-emoji">🏮</span><strong>Festivals</strong><small>Celebrations through the year</small><span class="category-arrow">↗</span></a>
        <a class="category-card category-blue" href="/learn/"><span class="category-emoji">🧭</span><strong>Learn</strong><small>Friendly guides for curious minds</small><span class="category-arrow">↗</span></a>
        <a class="category-card category-green" href="/books/"><span class="category-emoji">📚</span><strong>Books &amp; ideas</strong><small>Stories worth sharing</small><span class="category-arrow">↗</span></a>
        <a class="category-card category-lilac" href="/events/"><span class="category-emoji">🎏</span><strong>Events</strong><small>Meet, make and experience</small><span class="category-arrow">↗</span></a>
      </div>
    </section>

    <section class="spotlight-section">
      <div class="wrap">
        <div class="section-title-row"><div><span class="section-kicker">A LITTLE INSPIRATION</span><h2>Featured discoveries</h2><p class="section-subtitle">Interesting places to begin your next cultural adventure.</p></div><a class="all-link" href="/culture/">See all stories <span>→</span></a></div>
        <div class="spotlight-grid">
          <a class="spotlight-card spotlight-large" href="/culture/">
            <div class="spotlight-image image-calligraphy"><span class="image-character">書</span><span class="image-caption">ARTS &amp; TRADITIONS</span></div>
            <div class="spotlight-info"><div><span class="card-eyebrow">MAKE A DISCOVERY</span><h3>The beauty of Chinese arts</h3><p>Explore the creativity, craft and stories behind timeless traditions.</p></div><span class="round-arrow">↗</span></div>
          </a>
          <a class="spotlight-card" href="/festivals/">
            <div class="spotlight-image image-lantern"><span class="image-caption">FESTIVALS &amp; SEASONS</span></div>
            <div class="spotlight-info"><div><span class="card-eyebrow">CELEBRATE TOGETHER</span><h3>Traditions that bring us together</h3><p>Discover the meaning behind festive moments.</p></div><span class="round-arrow">↗</span></div>
          </a>
          <a class="spotlight-card" href="/learn/">
            <div class="spotlight-image image-learning"><span class="image-caption">LEARNING PATHS</span></div>
            <div class="spotlight-info"><div><span class="card-eyebrow">START WITH THE BASICS</span><h3>Small steps, big discoveries</h3><p>Build your knowledge with friendly introductions.</p></div><span class="round-arrow">↗</span></div>
          </a>
        </div>
      </div>
    </section>

    <section class="story-section wrap">
      <div class="section-title-row"><div><span class="section-kicker">YOUR NEXT CHAPTER</span><h2>Learn something wonderful</h2><p class="section-subtitle">Bite-sized guides to help you explore with confidence.</p></div><a class="all-link" href="/learn/">All learning guides <span>→</span></a></div>
      <div class="cards playful-cards">{lessons.map((item,i)=><StoryCard href={"/learn/"+item.id+"/"} title={item.data.title} description={item.data.description} category={"START HERE · 0"+(i+1)} readingMinutes={item.data.readingMinutes} chinese={item.data.chinese}/>)}</div>
    </section>

    <section class="festival-banner">
      <div class="festival-banner-art" role="img" aria-label="Red lanterns and warm lights at a Chinese festival"><span class="festival-sticker">一起<br/>庆祝!</span></div>
      <div class="festival-banner-copy"><span class="section-kicker">CELEBRATE THE MOMENTS</span><h2>Every season<br/>has a story.</h2><p>From family gatherings to colorful festivals, discover the customs, food and meaning that make each celebration special.</p>
        {#if featuredFestival}<a class="pill-button pill-white" href={"/festivals/"+featuredFestival.id+"/"}>Explore a festival <span>→</span></a>{:else}<a class="pill-button pill-white" href="/festivals/">Explore festivals <span>→</span></a>{/if}
      </div>
    </section>

    <section class="culture-section wrap">
      <div class="section-title-row"><div><span class="section-kicker">CULTURE, UP CLOSE</span><h2>Stories to spark your imagination</h2><p class="section-subtitle">Take a closer look at the ideas, objects and traditions that shape daily life.</p></div><a class="all-link" href="/culture/">Discover more <span>→</span></a></div>
      <div class="cards playful-cards">{traditions.map((item)=><StoryCard href={"/culture/"+item.id+"/"} title={item.data.title} description={item.data.description} category={item.data.category} readingMinutes={item.data.readingMinutes} chinese={item.data.chinese}/>)}</div>
    </section>

    <section class="reading-feature">
      <div class="wrap reading-feature-inner">
        <div class="reading-art"><span class="book-sun"></span><span class="book-character">知</span><span class="book-label">THE READING CORNER</span></div>
        <div class="reading-copy"><span class="section-kicker">OPEN A BOOK, OPEN A WORLD</span><h2>Big ideas.<br/><em>Wonderful stories.</em></h2><p>Meet the books, thinkers and timeless ideas that have shaped Chinese culture.</p>
          <div class="reading-links">{books.map((item)=><a href={"/books/"+item.id+"/"}><span>{item.data.title}</span><b>↗</b></a>)}{books.length===0 && <a href="/books/"><span>Explore the reading room</span><b>↗</b></a>}</div>
          <a class="pill-button pill-red" href="/books/">Visit the reading corner <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="community-cta wrap">
      <div class="community-icon">你好!</div>
      <div><span class="section-kicker">EVERYONE IS WELCOME</span><h2>Come curious.<br/>Leave inspired.</h2><p>Culture is a conversation. Join us to discover new perspectives, share what you learn and keep exploring.</p><a class="pill-button pill-red" href="/about/">Get to know us <span>→</span></a></div>
    </section>
  </div>
</BaseLayout>
