---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StoryCard from "../../../components/StoryCard.astro";
import {getCollection,render} from "astro:content";
import {supportedLocales,localizedSections,ui} from "../../../i18n/site";
export function getStaticPaths(){return supportedLocales.flatMap(locale=>localizedSections[locale].map(config=>({params:{locale,section:config.route},props:{locale,config}})));}
const {locale,config}=Astro.props,labels=ui[locale];
const cultureHeroImage="https://thumb.wikimedia.org/wikipedia/commons/thumb/5/56/Peking_Hutong_courtyard.JPG/960px-Peking_Hutong_courtyard.JPG";
const entries=config.collection?(await getCollection(config.collection as any)).filter((e:any)=>(e.data.status??"published")==="published").sort((a:any,b:any)=>(a.data.order??99)-(b.data.order??99)||a.data.title.localeCompare(b.data.title)):[];
const books=config.route==="books"?await Promise.all(entries.map(async(entry:any,index:number)=>({entry,index,Content:(await render(entry)).Content}))):[];
const heroArt=[
"https://upload.wikimedia.org/wikipedia/commons/2/27/Gong_Xian_-_Landscape.jpg",
"https://upload.wikimedia.org/wikipedia/commons/3/32/Chinese_-_Landscape_-_Walters_35101K.jpg",
"https://upload.wikimedia.org/wikipedia/commons/d/df/Shen_Zhou_%E6%B2%88%E5%91%A8_-_Landscape%2C_in_Ming_style_-_y1949-85_-_Princeton_University_Art_Museum.jpg",
"https://upload.wikimedia.org/wikipedia/commons/1/12/Chinese_-_Country-scenes_in_Mountain_Landscape_-_Walters_354.jpg",
"https://upload.wikimedia.org/wikipedia/commons/b/ba/Wang_Hui%2C_landscape_painting.jpg"
];
const art=[["dao-de-jing.svg","水墨山水、流水與竹簡，象徵道法自然。"],["lun-yu.svg","古代書院、講席與展卷問學。"],["da-xue.svg","庭院階梯與書卷，象徵修身齊家。"],["zhong-yong.svg","石橋、靜水與遠山，象徵中和之道。"],["chu-xiu-dao-gan-yan.svg","晨霧中的靜修小屋與松樹，象徵日常省思。"]];
---
<BaseLayout title={config.nav} description={config.description} locale={locale}>
{config.route==="books"?<div class="books">
<section class="hero hero-slider" data-hero-slider aria-label="五本經典專題輪播">
<div class="hero-slides" data-hero-track>
{books.map(({entry,index})=><article class:list={["hero-slide",index===0&&"active"]} data-hero-slide aria-hidden={index===0?"false":"true"}>
<img class="hero-slide-art" src={heroArt[index]} alt={["龔賢山水畫，層巒與林木","華特斯藝術博物館藏中國山水畫","沈周明代山水畫，山徑與松樹","華特斯藝術博物館藏山中村景","王翬清代山水畫"][index]} loading={index===0?"eager":"lazy"}/>
<div class="hero-slide-shade"></div>
<div class="wrap hero-slide-content"><span class="eyebrow">典籍專題・0{index+1} / 05</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p><a href={"#"+entry.id}>開始閱讀 <span aria-hidden="true">↗</span></a></div>
<a class="hero-slide-cover" href={"#"+entry.id} aria-label={"閱讀《"+entry.data.title+"》"}><img src={entry.data.image} alt={entry.data.imageAlt??entry.data.title} width="360" height="500"/></a>
</article>)}
</div>
<div class="hero-slider-controls"><button type="button" data-hero-prev aria-label="上一部典籍">←</button><div class="hero-slider-dots">{books.map(({entry,index})=><button type="button" data-hero-dot data-index={index} class:active={index===0} aria-label={"顯示"+entry.data.title}></button>)}</div><button type="button" data-hero-next aria-label="下一部典籍">→</button><span>五部典籍・每 6 秒自動切換</span></div>
</section>
<section class="carousel-wrap" id="book-carousel"><div class="wrap"><div class="section-head"><div><span class="eyebrow">五部原書・一頁閱讀</span><h2>循著書頁，展開閱讀</h2></div><p>選擇一本書，直接前往本頁相應篇章。</p></div><div class="carousel" data-carousel><div class="viewport"><div class="track" data-track>{books.map(({entry,index})=><article class:list={["slide",index===0&&"active"]} data-slide aria-hidden={index===0?"false":"true"}><a class="cover" href={"#"+entry.id} tabindex={index===0?0:-1}><img src={entry.data.image} alt={entry.data.imageAlt??entry.data.title} loading={index===0?"eager":"lazy"} width="360" height="500"/></a><div><small>0{index+1} / 05・{entry.data.category}</small><h3>{entry.data.title}</h3><p>{entry.data.description}</p><a class="start" href={"#"+entry.id}>開始閱讀 ↗</a></div></article>)}</div></div><div class="controls"><button type="button" data-prev aria-label="上一部書">←</button><button type="button" data-next aria-label="下一部書">→</button><div class="dots">{books.map(({entry,index})=><button type="button" data-dot data-index={index} class:active={index===0} aria-label={"顯示"+entry.data.title}></button>)}</div><small>每 6 秒切換</small></div></div></div></section>
<nav class="toc" aria-label="五本書目錄"><div class="wrap"><b>本頁目錄</b><div>{books.map(({entry,index})=><a href={"#"+entry.id}>0{index+1}　{entry.data.title}</a>)}</div></div></nav>
<section class="intro wrap"><span class="eyebrow">閱讀說明</span><h2>五本原書，依序展讀</h2><p>{config.note}</p><p>以下保留原書可擷取文字、章節順序與段落。原書圖像頁或無法擷取的文字不作臆測補寫；如需核對，請以原始版本為準。</p></section>
<div class="wrap reading">{books.map(({entry,index,Content})=><section class="book" id={entry.id}><header><div><span class="eyebrow">典籍 0{index+1} / 05</span><h2>{entry.data.title}</h2><p>{entry.data.description}</p><small>{entry.data.imageCredit}</small></div><img class="book-cover" src={entry.data.image} alt={entry.data.imageAlt??entry.data.title} loading="lazy" width="360" height="500"/></header><figure><img src={"/assets/books/illustrations/"+art[index][0]} alt={"原創文化編輯插畫："+art[index][1]} loading="lazy" width="900" height="560"/><figcaption>原創編輯插畫・非歷史照片｜{art[index][1]}</figcaption></figure><nav class="chapter-nav" data-chapters data-book={entry.id}><b>本書章節導覽</b><div></div></nav><article class="prose" lang="zh-Hant"><Content/></article><footer><span>本書閱讀完畢</span><a href="#book-carousel">返回五書選讀 ↑</a></footer></section>)}</div><p class="back wrap"><a href="#book-carousel">回到頁首・重新選讀 ↑</a></p></div>
:<><section class={config.route==="culture"?"page-hero-photo":"page-hero-plain"} style={config.route==="culture"?`--section-photo: url("${cultureHeroImage}")`:undefined}><div class="wrap"><span class="eyebrow">{config.eyebrow}</span><h1>{config.title}</h1><p class="lead">{config.description}</p></div></section>{config.route==="events"?<section class="section"><div class="wrap"><div class="empty-state"><h2>{labels.noEvents}</h2><p>{labels.eventNote}</p></div></div></section>:<section class="section collection-grid"><div class="wrap"><p class="index-note">{config.note} · {entries.length} {labels.guides}</p>{entries.length?<div class="cards">{entries.map((entry:any,i:number)=><StoryCard href={"/"+locale+"/"+config.route+"/"+entry.id+"/"} title={entry.data.title} description={entry.data.description} category={entry.data.category} readingMinutes={entry.data.readingMinutes} chinese={entry.data.chinese} number={i+1} image={entry.data.image} imageAlt={entry.data.imageAlt}/>)}</div>:<div class="empty-state"><h2>{labels.noArticles}</h2></div>}</div></section>}</>}
</BaseLayout>
<style>
.books{background:#f5f0e6;color:#292d28;--red:#984234;--line:#d9d0c1}.hero{min-height:530px;position:relative;isolation:isolate;display:flex;align-items:center;overflow:hidden;background:#ded0b7}.hero>img,.hero-overlay{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.hero-overlay{z-index:-1;background:linear-gradient(90deg,#f4ead6ed,#f4ead6c5 48%,transparent 88%)}.hero-copy{padding:5rem 0}.hero h1{font-size:clamp(3.5rem,8vw,7rem);line-height:1.12;color:#28332e;margin:0 0 1rem;letter-spacing:.06em}.hero h1 em{font-style:normal;color:var(--red)}.hero p{font:1.2rem/1.9 Georgia,serif;letter-spacing:.1em;color:#4d554d}.hero a,.start{display:inline-block;margin-top:1rem;padding:.7rem 0;border-bottom:1px solid var(--red);color:var(--red);font-weight:700;text-decoration:none}.hero-slider{height:530px;min-height:0;display:block;position:relative;background:#ded0b7}.hero-slides{height:100%;position:relative;overflow:hidden}.hero-slide{position:absolute;inset:0;display:flex;align-items:center;opacity:0;visibility:hidden;transition:opacity .8s ease;isolation:isolate}.hero-slide.active{opacity:1;visibility:visible;z-index:1}.hero-slide-art,.hero-slide-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-slide-art{z-index:-2;filter:saturate(.82)}.hero-slide-shade{z-index:-1;background:linear-gradient(90deg,#f4ead6f2 0%,#f4ead6df 38%,#f4ead68c 65%,#f4ead620 100%)}.hero-slide-content{position:relative;z-index:2;padding:3.5rem 0;max-width:1100px}.hero-slide-content h1{max-width:720px;font-size:clamp(3rem,6vw,5.8rem);line-height:1.12;color:#28332e;margin:.8rem 0 1rem}.hero-slide-content p{max-width:650px;font:1.12rem/1.9 Georgia,"Noto Serif TC",serif;color:#4d554d}.hero-slide-content>a{display:inline-block;margin-top:1rem;padding:.7rem 0;border-bottom:1px solid var(--red);color:var(--red);font-weight:700;text-decoration:none}.hero-slide-cover{position:absolute;z-index:3;right:max(calc((100vw - 1100px)/2),5%);top:50%;transform:translateY(-50%) rotate(3deg);width:190px;height:265px;box-shadow:12px 15px 30px #30271955}.hero-slide-cover img{width:100%;height:100%;object-fit:cover;display:block}.hero-slider-controls{position:absolute;z-index:5;left:50%;bottom:1.1rem;transform:translateX(-50%);display:flex;align-items:center;gap:.8rem;padding:.45rem .75rem;background:#f7f0e2df;border:1px solid #c9bda8;border-radius:30px;backdrop-filter:blur(8px)}.hero-slider-controls>button{width:30px;height:30px;border:1px solid #c8bead;border-radius:50%;background:#fffaf0;color:#984234;cursor:pointer}.hero-slider-dots{display:flex;gap:.45rem}.hero-slider-dots button{width:8px;height:8px;padding:0;border:0;border-radius:50%;background:#bdb5a8;cursor:pointer}.hero-slider-dots button.active{width:22px;border-radius:8px;background:#984234}.hero-slider-controls span{font-size:.68rem;color:#766d60;margin-left:.3rem}@media(max-width:700px){.hero-slider{height:480px}.hero-slide-shade{background:linear-gradient(90deg,#f4ead6f4,#f4ead6d9 70%,#f4ead688)}.hero-slide-content{padding:2.5rem 0 5rem}.hero-slide-content h1{font-size:clamp(2.6rem,11vw,4rem);max-width:75%}.hero-slide-content p{font-size:.92rem;max-width:75%;line-height:1.65}.hero-slide-cover{width:100px;height:145px;right:5%;top:auto;bottom:4.6rem;transform:rotate(3deg)}.hero-slider-controls{bottom:.7rem;gap:.55rem}.hero-slider-controls span{display:none}}@media(prefers-reduced-motion:reduce){.hero-slide{transition:none}}.carousel-wrap{padding:4rem 0;background:#faf7f0}.section-head{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin-bottom:1.5rem}.section-head h2,.intro h2{font-size:clamp(2rem,4vw,3rem);margin:0}.section-head p{color:#687067}.carousel{border:1px solid var(--line);background:#f1eadc}.viewport{overflow:hidden}.track{display:flex;transition:transform .6s}.slide{flex:0 0 100%;display:grid;grid-template-columns:.7fr 1.3fr;align-items:center;gap:5rem;min-height:340px;padding:2.5rem 8%}.cover{width:190px;height:265px;justify-self:center;box-shadow:10px 12px 24px #332b1c32}.cover img,.book-cover{width:100%;height:100%;object-fit:cover;display:block}.slide h3{font-size:clamp(2rem,4vw,3.3rem);margin:.7rem 0}.slide p{line-height:1.9;color:#666b61}.slide small{color:var(--red)}.controls{display:flex;align-items:center;gap:.8rem;padding:1rem;border-top:1px solid var(--line)}.controls>button{width:36px;height:36px;border:1px solid #c8bead;background:transparent;cursor:pointer}.dots{display:flex;gap:.5rem;margin-left:.5rem}.dots button{width:8px;height:8px;border:0;border-radius:50%;background:#bdb5a8;padding:0;cursor:pointer}.dots button.active{width:24px;border-radius:8px;background:var(--red)}.controls small{margin-left:auto;color:#898579}.toc{position:sticky;top:0;z-index:20;background:#ede5d6f2;backdrop-filter:blur(10px);border-block:1px solid var(--line)}.toc .wrap{display:flex;align-items:center;gap:1.2rem;min-height:60px}.toc b{flex:none;color:var(--red);font-size:.8rem}.toc .wrap>div{display:flex;gap:1.5rem;overflow-x:auto;white-space:nowrap}.toc a{font-size:.82rem;text-decoration:none}.intro{padding:4rem 0 2rem}.intro p{max-width:820px;line-height:2;color:#656b61}.book{padding:4rem 0;border-top:1px solid var(--line);scroll-margin-top:85px}.book header{display:grid;grid-template-columns:1fr 140px;gap:2rem;align-items:center;margin-bottom:2rem}.book header h2{font-size:clamp(2.5rem,5vw,4rem);margin:0 0 1rem}.book header p{color:#62695f;line-height:1.9}.book header small{color:#898274}.book-cover{width:125px;height:175px;box-shadow:7px 9px 18px #332b1c26}.book figure{max-width:900px;margin:0 auto 2rem}.book figure img{width:100%;max-height:360px;object-fit:cover}.book figcaption{text-align:right;font-size:.74rem;color:#898274}.chapter-nav{padding:1rem 0;margin:2rem 0;border-block:1px solid var(--line)}.chapter-nav b{color:var(--red);font-size:.8rem}.chapter-nav div{display:flex;flex-wrap:wrap;gap:.5rem 1rem;margin-top:.7rem}.chapter-nav a{font-size:.8rem;text-decoration:none;color:#596257}.prose{max-width:790px;margin:auto;font:1.05rem/2.1 Georgia,"Noto Serif TC","Songti TC",serif;color:#353a34;overflow-wrap:anywhere}.prose h2{font-size:1.7rem;margin:3rem 0 1.3rem;padding-left:1rem;border-left:3px solid #a34c3d;scroll-margin-top:100px}.prose h3{scroll-margin-top:100px}.prose p{max-width:none;margin:0 0 1.2rem;white-space:pre-line}.book footer{display:flex;gap:2rem;margin-top:3rem;padding-top:1rem;border-top:1px solid var(--line);font-size:.8rem;color:#777}.book footer a,.back a{color:var(--red);text-decoration:none}.back{text-align:center;padding:2rem 0 4rem}
@media(max-width:700px){.hero{min-height:460px}.hero-overlay{background:linear-gradient(90deg,#f4ead6f2,#f4ead6c9 70%,#f4ead680)}.hero-copy{padding:3rem 0}.hero h1{font-size:clamp(3rem,14vw,5rem)}.carousel-wrap{padding:3rem 0}.section-head{display:block}.slide{grid-template-columns:105px minmax(0,1fr);gap:1rem;min-height:260px;padding:1.2rem .8rem}.cover{width:100px;height:150px}.slide h3{font-size:1.6rem}.slide p{font-size:.82rem;line-height:1.6}.controls small{display:none}.toc .wrap{display:block;padding:.5rem 0}.toc b{display:block;margin-bottom:.3rem}.toc .wrap>div{gap:1rem}.toc a{font-size:.76rem}.intro{padding:3rem 0 1.5rem}.book{padding:3rem 0}.book header{grid-template-columns:1fr 85px;gap:1rem}.book-cover{width:80px;height:115px}.book header h2{font-size:2.2rem}.book header p{font-size:.9rem}.book figure img{max-height:220px}.prose{font-size:1rem;line-height:2}.prose h2{font-size:1.4rem}}
@media(prefers-reduced-motion:reduce){.track{transition:none}}
</style>
<script>
const init=()=>{const hero=document.querySelector("[data-hero-slider]");if(hero&&!hero.dataset.ready){hero.dataset.ready="1";const slides=[...hero.querySelectorAll("[data-hero-slide]")],dots=[...hero.querySelectorAll("[data-hero-dot]")],prev=hero.querySelector("[data-hero-prev]"),next=hero.querySelector("[data-hero-next]"),reduced=matchMedia("(prefers-reduced-motion: reduce)");let index=0,timer=null,paused=reduced.matches,interacted=false;const show=n=>{index=(n+slides.length)%slides.length;slides.forEach((slide,j)=>slide.classList.toggle("active",j===index)),slides.forEach((slide,j)=>slide.setAttribute("aria-hidden",String(j!==index)));dots.forEach((dot,j)=>dot.classList.toggle("active",j===index))};const stop=()=>{paused=true;interacted=true;clearInterval(timer)};const start=()=>{clearInterval(timer);if(!paused&&!interacted&&!reduced.matches)timer=setInterval(()=>show(index+1),6000)};prev.addEventListener("click",()=>{stop();show(index-1)});next.addEventListener("click",()=>{stop();show(index+1)});dots.forEach(dot=>dot.addEventListener("click",()=>{stop();show(Number(dot.dataset.index))}));hero.addEventListener("mouseenter",()=>clearInterval(timer));hero.addEventListener("mouseleave",start);hero.addEventListener("focusin",stop);hero.addEventListener("pointerdown",stop);hero.addEventListener("keydown",event=>{if(event.key==="ArrowLeft"){stop();show(index-1)}if(event.key==="ArrowRight"){stop();show(index+1)}});let touchX=0;hero.addEventListener("touchstart",event=>touchX=event.changedTouches[0].clientX,{passive:true});hero.addEventListener("touchend",event=>{const delta=event.changedTouches[0].clientX-touchX;if(Math.abs(delta)>45){stop();show(index+(delta<0?1:-1))}},{passive:true});reduced.addEventListener?.("change",event=>{if(event.matches){paused=true;clearInterval(timer)}else if(!interacted){paused=false;start()}});show(0);start()}const root=document.querySelector("[data-carousel]");if(root&&!root.dataset.ready){root.dataset.ready="1";const track=root.querySelector("[data-track]"),slides=[...root.querySelectorAll("[data-slide]")],dots=[...root.querySelectorAll("[data-dot]")],prev=root.querySelector("[data-prev]"),next=root.querySelector("[data-next]"),reduced=matchMedia("(prefers-reduced-motion: reduce)");let i=0,paused=reduced.matches,interacted=false,timer;const draw=n=>{i=(n+slides.length)%slides.length;track.style.transform=`translateX(-${i*100}%)`;slides.forEach((s,j)=>{s.setAttribute("aria-hidden",String(i!==j));s.querySelectorAll("a").forEach(a=>a.tabIndex=i===j?0:-1)});dots.forEach((d,j)=>d.classList.toggle("active",i===j))};const stop=()=>{paused=true;interacted=true;clearInterval(timer)};const start=()=>{clearInterval(timer);if(!paused&&!interacted&&!reduced.matches)timer=setInterval(()=>draw(i+1),6000)};prev.addEventListener("click",()=>{stop();draw(i-1)});next.addEventListener("click",()=>{stop();draw(i+1)});dots.forEach(d=>d.addEventListener("click",()=>{stop();draw(+d.dataset.index)}));root.addEventListener("mouseenter",()=>clearInterval(timer));root.addEventListener("mouseleave",start);root.addEventListener("focusin",stop);root.addEventListener("pointerdown",stop);root.addEventListener("keydown",e=>{if(e.key==="ArrowLeft"){stop();draw(i-1)}if(e.key==="ArrowRight"){stop();draw(i+1)}});let x=0;root.addEventListener("touchstart",e=>x=e.changedTouches[0].clientX,{passive:true});root.addEventListener("touchend",e=>{const d=e.changedTouches[0].clientX-x;if(Math.abs(d)>45){stop();draw(i+(d<0?1:-1))}},{passive:true});reduced.addEventListener?.("change",e=>{if(e.matches){paused=true;clearInterval(timer)}});draw(0);start()}document.querySelectorAll("[data-chapters]").forEach(nav=>{if(nav.dataset.ready)return;nav.dataset.ready="1";const id=nav.dataset.book,article=document.getElementById(id)?.querySelector(".prose"),box=nav.querySelector("div");if(!article)return;const heads=[...article.querySelectorAll("h2,h3")];heads.forEach((h,j)=>{h.id=`${id}-chapter-${j+1}`;const a=document.createElement("a");a.href="#"+h.id;a.textContent=h.textContent.trim();box.append(a)});if(!heads.length)nav.hidden=true})};if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",init,{once:true});else init();
</script>