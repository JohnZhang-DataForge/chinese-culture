---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StoryCard from "../../../components/StoryCard.astro";
import { getCollection } from "astro:content";
import { supportedLocales, localizedSections, ui } from "../../../i18n/site";

export function getStaticPaths() {
  return supportedLocales.flatMap((locale) => localizedSections[locale].map((config) => ({
    params: { locale, section: config.route }, props: { locale, config }
  })));
}
const { locale, config } = Astro.props;
const labels = ui[locale];
const entries = config.collection
  ? (await getCollection(config.collection as any)).sort((a: any,b: any)=>(a.data.order??99)-(b.data.order??99) || a.data.title.localeCompare(b.data.title))
  : [];
---
<BaseLayout title={config.nav} description={config.description} locale={locale}>
  <section class="page-hero"><div class="wrap"><span class="eyebrow">{config.eyebrow}</span><h1>{config.title}</h1><p class="lead">{config.description}</p></div></section>
  {config.route === "events" ? <section class="section"><div class="wrap"><div class="empty-state"><span class="eyebrow">{labels.upcoming}</span><h2>{labels.noEvents}</h2><p>{labels.eventNote}</p><p><a class="button" href={"/"+locale+"/festivals/"}>{labels.exploreFestivals} ↗</a></p></div></div></section> : <>
    <div class="wrap"><p class="index-note">{config.note} · {entries.length} {labels.guides}</p></div>
    <section class="collection-grid"><div class="wrap"><div class="cards">{entries.map((entry: any,i: number)=><StoryCard href={"/"+locale+"/"+config.route+"/"+entry.id+"/"} title={entry.data.title} description={entry.data.description} category={entry.data.category} readingMinutes={entry.data.readingMinutes} chinese={entry.data.chinese} number={i+1} image={entry.data.image} imageAlt={entry.data.imageAlt}/>)}</div></div></section>
  </>}
</BaseLayout>
