---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { supportedLocales, localizedSections, homeCopy } from "../../i18n/site";
export function getStaticPaths() {
  return supportedLocales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
const sections = localizedSections[locale];
const copy = homeCopy[locale];
const contentSections = sections.filter((section) => section.collection);
const collections = await Promise.all(contentSections.map((section) => getCollection(section.collection as any)));
const counts = Object.fromEntries(contentSections.map((section,index)=>[section.route,collections[index].filter((entry:any)=>(entry.data.status??"published")==="published").length]));
const emptyCopy = "全新的文章與圖片正在籌備中，敬請期待。";
const storyCount = Object.values(counts).reduce((total:number,count:any)=>total+count,0);
const bookSection = sections.find((section) => section.route === "books");
const books = locale === "zh-tw" && bookSection?.collection
  ? (await getCollection(bookSection.collection as any)).filter((entry:any)=>(entry.data.status??"published")==="published").sort((a:any,b:any)=>(a.data.order??99)-(b.data.order??99))
  : [];
const bookArt = ["dao-de-jing.svg","lun-yu.svg","da-xue.svg","zhong-yong.svg","chu-xiu-dao-gan-yan.svg"];
const bookArtAlt = ["水墨山水與竹簡，呈現道法自然的意境","古代書院與講席，呈現孔門問學的場景","層疊庭院與書卷，象徵修身齊家","靜水石橋與遠山，象徵中和之道","晨霧松林與靜修小屋，呈現日常省思"];
---
<BaseLayout title={locale === "zh-tw" ? "五本經典・一頁選讀" : "Discover Chinese culture"} description={locale === "zh-tw" ? "走進《道德經淺易》、《論語淺易》、《大學淺易》、《中庸淺易》與《初修道感言》，從五本原書開始閱讀。" : copy.intro} locale={locale}>
  {locale === "zh-tw" ? <main class="books-home">
    <section class="welcome-hero">
      <img class="welcome-art" src="/assets/books/illustrations/books-hero.svg" alt="原創水墨山水插畫：遠山、江河、竹林、亭台與古籍書案" fetchpriority="high"/>
      <div class="welcome-shade"></div>
      <div class="wrap welcome-copy"><span class="eyebrow">中國文化地圖・典籍選讀</span><h1>經典傳承<br/><em>智慧長存</em></h1><p>在經典中尋找智慧，在閱讀中傳承文化。</p><a href="#choose-a-book">選擇一本書，開始閱讀 <span aria-hidden="true">↓</span></a></div>
      <span class="hero-seal" aria-hidden="true">書<br/>香</span>
    </section>
    <section class="book-picker" id="choose-a-book">
      <div class="wrap">
        <header class="picker-heading"><div><span class="eyebrow">FIVE ORIGINAL BOOKS</span><h2>今天，想從哪一本開始？</h2><p>五本原書，一個連續的閱讀空間。選擇封面即可前往對應篇章。</p></div><span class="picker-count">五部典籍<br/><b>01 — 05</b></span></header>
        <div class="book-grid">
          {books.map((entry:any,index:number)=><article class="book-choice">
            <a class="choice-link" href={"/zh-tw/books/#"+entry.id} aria-label={"開始閱讀《"+entry.data.title+"》"}>
              <div class="choice-art"><img class="choice-illustration" src={"/assets/books/illustrations/"+bookArt[index]} alt={bookArtAlt[index]} loading="lazy" width="900" height="560"/><span class="choice-number">0{index+1}</span><img class="choice-cover" src={entry.data.image} alt={entry.data.imageAlt??entry.data.title} loading="lazy" width="360" height="500"/></div>
              <div class="choice-copy"><span class="choice-category">{entry.data.category}</span><h3>{entry.data.title}</h3><p>{entry.data.description}</p><span class="choice-cta">開始閱讀 <span aria-hidden="true">↗</span></span></div>
            </a>
          </article>)}
        </div>
        <p class="all-books-link"><a href="/zh-tw/books/">進入五本書完整連續閱讀頁 <span aria-hidden="true">→</span></a></p>
      </div>
    </section>
    <section class="reading-note"><div class="wrap"><span class="note-mark" aria-hidden="true">文</span><div><span class="eyebrow">一頁展讀・依序典藏</span><h2>讓閱讀，從此刻開始。</h2><p>五本書依原有次序完整呈現。保留原書可擷取文字、章節與段落，並以原創文化插畫陪伴閱讀。</p></div><a href="/zh-tw/books/">瀏覽全部典籍 <span aria-hidden="true">→</span></a></div></section>
  </main> : <div class="no-photo-home">
    <section class="no-photo-hero"><div class="wrap"><span class="eyebrow">{copy.eyebrow}</span><h1>{copy.heading}</h1><p class="lead">{copy.intro}</p><p class="home-empty-note">{storyCount===0?emptyCopy:copy.exploreIntro}</p></div></section>
    <section class="section no-photo-sections"><div class="wrap">
      <div class="section-heading"><span class="eyebrow">{copy.topics}</span><h2>{copy.exploreTitle}</h2><p>{copy.exploreIntro}</p></div>
      <div class="section-link-grid">{sections.map((section,index)=><a class="section-link-card" href={"/"+locale+"/"+section.route+"/"}>
        <span class="section-number">{String(index+1).padStart(2,"0")}</span>
        <div class="section-link-copy"><span class="section-link-eyebrow">{section.eyebrow}</span><h3>{section.nav}</h3><p>{section.description}</p><small>{counts[section.route]??0} {locale==="zh-cn"||locale==="zh-tw"?"篇內容":locale==="es"?"artículos":"articles"}</small></div>
        <span class="section-link-arrow" aria-hidden="true">↗</span>
      </a>)}</div>
    </div></section>
    <section class="home-bottom-callout"><div class="wrap"><span class="callout-chinese">文化</span><div><span class="section-kicker">CHINESE CULTURE ATLAS</span><h2>{copy.callout}</h2><p>{copy.calloutText}</p></div><a class="pill-button pill-white" href={"/"+locale+"/about/"}>{copy.about} <span>→</span></a></div></section>
  </div>}
</BaseLayout>
<style>
.books-home{background:#f5f0e6;color:#292e29;--accent:#984234;--rule:#d8cdbb}.welcome-hero{position:relative;isolation:isolate;min-height:590px;display:flex;align-items:center;overflow:hidden;background:#d9c9ae}.welcome-art,.welcome-shade{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:-2}.welcome-shade{z-index:-1;background:linear-gradient(90deg,#f5ead8f2 0%,#f5ead8d9 40%,#f5ead860 72%,transparent 100%)}.welcome-copy{padding:5rem 0}.welcome-copy h1{font-size:clamp(3.8rem,8vw,7rem);line-height:1.13;letter-spacing:.07em;margin:.8rem 0 1.2rem;color:#29352f}.welcome-copy h1 em{font-style:normal;color:var(--accent)}.welcome-copy p{font:1.2rem/1.9 Georgia,"Noto Serif TC",serif;letter-spacing:.12em;color:#51584f}.welcome-copy>a{display:inline-flex;gap:1rem;margin-top:1.5rem;padding:.85rem 0;border-bottom:1px solid var(--accent);color:var(--accent);font-weight:700;text-decoration:none}.hero-seal{position:absolute;right:8%;bottom:12%;display:grid;place-content:center;width:66px;height:66px;border:2px solid #984234a8;color:#984234;font-family:serif;font-size:1.25rem;line-height:1.1;text-align:center;transform:rotate(8deg)}.book-picker{padding:5rem 0 4rem}.picker-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:2rem}.picker-heading h2{font-size:clamp(2rem,4vw,3.3rem);margin:.35rem 0}.picker-heading p{color:#6b6d62;line-height:1.8}.picker-count{flex:none;text-align:right;color:#8b8171;font-size:.8rem;line-height:1.8}.picker-count b{font:1.1rem Georgia,serif;color:var(--accent);letter-spacing:.12em}.book-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:1.1rem}.book-choice{min-width:0;background:#fbf8f1;border:1px solid var(--rule);transition:transform .25s,box-shadow .25s}.book-choice:hover{transform:translateY(-6px);box-shadow:0 16px 30px #43351d18}.choice-link{display:block;color:inherit;text-decoration:none;height:100%}.choice-art{position:relative;aspect-ratio:4/4.7;overflow:hidden;background:#e1d5c1}.choice-illustration{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}.book-choice:hover .choice-illustration{transform:scale(1.045)}.choice-art:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,#28251b10 40%,#28251b45)}.choice-number{position:absolute;z-index:1;top:.8rem;left:.8rem;color:#fff;font:1rem Georgia,serif;text-shadow:0 1px 5px #333}.choice-cover{position:absolute;z-index:2;width:34%;height:58%;right:10%;bottom:9%;object-fit:cover;box-shadow:5px 8px 16px #1d1a1645;transform:rotate(3deg);transition:transform .3s}.book-choice:hover .choice-cover{transform:rotate(0) translateY(-4px)}.choice-copy{padding:1.15rem 1rem 1.25rem}.choice-category{font-size:.7rem;color:var(--accent);letter-spacing:.08em}.choice-copy h3{font-size:1.22rem;line-height:1.45;margin:.5rem 0}.choice-copy p{font-size:.82rem;line-height:1.8;color:#6d6e65;min-height:6.5rem}.choice-cta{display:flex;justify-content:space-between;border-top:1px solid var(--rule);padding-top:.8rem;margin-top:.8rem;color:var(--accent);font-weight:700;font-size:.82rem}.all-books-link{text-align:center;margin:2.5rem 0 0}.all-books-link a{color:var(--accent);text-decoration:none;border-bottom:1px solid #b78b7c;padding-bottom:.3rem}.reading-note{background:#eae1d2;padding:3rem 0}.reading-note .wrap{display:grid;grid-template-columns:65px 1fr auto;gap:1.5rem;align-items:center}.note-mark{display:grid;place-items:center;width:58px;height:58px;background:#984234;color:#fff;font:1.5rem serif}.reading-note h2{font-size:1.7rem;margin:.3rem 0}.reading-note p{max-width:720px;line-height:1.8;color:#62665d}.reading-note .wrap>a{color:var(--accent);text-decoration:none;white-space:nowrap;font-weight:700}
@media(max-width:1000px){.book-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.choice-copy p{min-height:5rem}}
@media(max-width:650px){.welcome-hero{min-height:480px}.welcome-shade{background:linear-gradient(90deg,#f5ead8f4,#f5ead8c9 78%,#f5ead870)}.welcome-copy{padding:3.5rem 0}.welcome-copy h1{font-size:clamp(3.1rem,15vw,4.8rem)}.welcome-copy p{font-size:1rem;max-width:19rem}.hero-seal{right:7%;bottom:8%;width:52px;height:52px;font-size:1rem}.book-picker{padding:3rem 0}.picker-heading{align-items:start}.picker-heading h2{font-size:2rem}.picker-heading p{font-size:.88rem}.picker-count{font-size:.68rem}.book-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.choice-copy{padding:.9rem .75rem}.choice-copy h3{font-size:1.05rem}.choice-copy p{font-size:.78rem;min-height:7.2rem}.choice-art{aspect-ratio:4/4.5}.reading-note .wrap{grid-template-columns:48px 1fr;gap:1rem}.note-mark{width:46px;height:46px}.reading-note h2{font-size:1.4rem}.reading-note p{font-size:.85rem}.reading-note .wrap>a{grid-column:2}}
@media(prefers-reduced-motion:reduce){.book-choice,.choice-illustration,.choice-cover{transition:none}}
</style>
