---
import "../../styles/admin.css";
const demo = import.meta.env.DEV;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#172b27" />
    <title>Admin · Chinese Culture Atlas</title>
    <meta name="description" content="Private administration workspace for Chinese Culture Atlas." />
  </head>
  <body class="admin-body">
    <div class="admin-shell" data-admin-app data-demo={demo ? "true" : "false"}>
      <aside class="admin-sidebar" id="admin-sidebar" aria-label="Admin navigation">
        <a class="admin-brand" href="/admin/" aria-label="Chinese Culture Atlas admin home">
          <span class="admin-brand-mark" aria-hidden="true">文</span>
          <span class="admin-brand-copy"><strong>Culture Atlas</strong><small>EDITORIAL STUDIO</small></span>
        </a>
        <div class="sidebar-divider"></div>
        <p class="sidebar-label">WORKSPACE</p>
        <nav class="admin-nav" aria-label="Workspace">
          <button class="nav-item is-active" type="button" data-nav="dashboard"><span class="nav-icon">◫</span><span>Overview</span></button>
          <button class="nav-item" type="button" data-nav="articles"><span class="nav-icon">▤</span><span>Articles</span><span class="nav-count" data-count="articles">—</span></button>
          <button class="nav-item" type="button" data-nav="lessons"><span class="nav-icon">▧</span><span>Learning guides</span><span class="nav-count" data-count="lessons">—</span></button>
          <button class="nav-item" type="button" data-nav="festivals"><span class="nav-icon">✳</span><span>Festivals</span><span class="nav-count" data-count="festivals">—</span></button>
          <button class="nav-item" type="button" data-nav="books"><span class="nav-icon">▥</span><span>Books</span><span class="nav-count" data-count="books">—</span></button>
          <button class="nav-item" type="button" data-nav="events"><span class="nav-icon">◷</span><span>Events</span><span class="nav-count" data-count="events">—</span></button>
        </nav>
        <p class="sidebar-label sidebar-label-spaced">SITE MANAGEMENT</p>
        <nav class="admin-nav" aria-label="Site management">
          <button class="nav-item" type="button" data-nav="homepage"><span class="nav-icon">⌂</span><span>Homepage</span></button>
          <button class="nav-item" type="button" data-nav="settings"><span class="nav-icon">⚙</span><span>Navigation &amp; settings</span></button>
          <button class="nav-item" type="button" data-nav="media"><span class="nav-icon">▧</span><span>Media library</span></button>
          <button class="nav-item" type="button" data-nav="languages"><span class="nav-icon">文</span><span>Languages</span></button>
        </nav>
        <div class="sidebar-bottom">
          <div class="sidebar-help"><span class="help-icon">?</span><div><strong>Need a hand?</strong><small>Editorial workspace guide</small></div><span aria-hidden="true">↗</span></div>
          <div class="admin-profile"><span class="profile-avatar">E</span><span><strong>Editorial team</strong><small>Administrator</small></span><span class="profile-menu" aria-hidden="true">•••</span></div>
        </div>
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <div class="topbar-left">
            <button class="icon-button mobile-menu-button" type="button" data-action="toggle-sidebar" aria-label="Open navigation">☰</button>
            <div class="breadcrumbs"><span>Workspace</span><span class="crumb-slash">/</span><strong data-breadcrumb>Overview</strong></div>
          </div>
          <div class="topbar-actions">
            <label class="global-search"><span aria-hidden="true">⌕</span><input type="search" placeholder="Search content..." aria-label="Search content" data-global-search /><kbd>⌘ K</kbd></label>
            <a class="topbar-site-link" href="/" target="_blank" rel="noreferrer">View website <span aria-hidden="true">↗</span></a>
            <button class="icon-button notification-button" type="button" aria-label="Notifications"><span aria-hidden="true">♧</span><i></i></button>
            <span class="topbar-avatar" aria-label="Editorial team">E</span>
          </div>
        </header>

        <main class="admin-content">
          <section class="admin-page" data-page="dashboard">
            <div class="page-heading">
              <div><p class="eyebrow-admin">THURSDAY, NOVEMBER 5</p><h1>Good morning, editor.</h1><p class="page-subtitle">Here’s what’s happening across your culture library.</p></div>
              <button class="primary-button" type="button" data-action="new-content"><span>＋</span> Create content</button>
            </div>
            <div class="stats-grid">
              <article class="stat-card"><div class="stat-top"><span>Total content</span><span class="stat-icon icon-jade">▤</span></div><strong data-stat="total">—</strong><small><span class="stat-neutral">Across all collections</span></small></article>
              <article class="stat-card"><div class="stat-top"><span>Published</span><span class="stat-icon icon-green">↗</span></div><strong data-stat="published">—</strong><small><span class="stat-positive">Live on your website</span></small></article>
              <article class="stat-card"><div class="stat-top"><span>Drafts</span><span class="stat-icon icon-amber">✎</span></div><strong data-stat="drafts">—</strong><small><span class="stat-neutral">Waiting for review</span></small></article>
              <article class="stat-card"><div class="stat-top"><span>Translations needed</span><span class="stat-icon icon-red">文</span></div><strong data-stat="translations">—</strong><small><span class="stat-neutral">Missing Chinese or English</span></small></article>
            </div>
            <div class="dashboard-grid">
              <article class="panel recent-panel">
                <div class="panel-heading"><div><h2>Recently updated</h2><p>Your latest editorial activity</p></div><button class="text-button" type="button" data-action="open-articles">View all <span>→</span></button></div>
                <div class="table-wrap"><table class="admin-table"><thead><tr><th>CONTENT</th><th>COLLECTION</th><th>STATUS</th><th>UPDATED</th><th></th></tr></thead><tbody data-recent-rows><tr><td colspan="5" class="table-loading">Loading content workspace…</td></tr></tbody></table></div>
              </article>
              <article class="panel activity-panel">
                <div class="panel-heading"><div><h2>Editorial checklist</h2><p>Keep the library in good shape</p></div><span class="checklist-count">4 tasks</span></div>
                <div class="checklist">
                  <div class="check-row"><span class="check-circle">✓</span><span><strong>Review new submissions</strong><small>Check drafts before publishing</small></span><span class="check-arrow">→</span></div>
                  <div class="check-row"><span class="check-circle check-pending"></span><span><strong>Complete translations</strong><small>Keep English and Chinese aligned</small></span><span class="check-arrow">→</span></div>
                  <div class="check-row"><span class="check-circle check-pending"></span><span><strong>Check featured stories</strong><small>Refresh the homepage spotlight</small></span><span class="check-arrow">→</span></div>
                  <div class="check-row"><span class="check-circle check-pending"></span><span><strong>Review media descriptions</strong><small>Add meaningful alt text</small></span><span class="check-arrow">→</span></div>
                </div>
              </article>
            </div>
            <div class="welcome-strip"><div class="welcome-mark">文</div><div><strong>A thoughtful library starts with good stories.</strong><p>Write with context, respect regional differences, and keep sources close at hand.</p></div><a href="/editorial-policy/" target="_blank" rel="noreferrer">Editorial principles ↗</a></div>
          </section>

          <section class="admin-page" data-page="content" hidden>
            <div class="page-heading">
              <div><p class="eyebrow-admin">CONTENT LIBRARY</p><h1 data-content-heading>Articles</h1><p class="page-subtitle" data-content-subtitle>Manage stories, metadata and publication status.</p></div>
              <button class="primary-button" type="button" data-action="new-content"><span>＋</span> New <span data-new-label>article</span></button>
            </div>
            <div class="panel library-panel">
              <div class="library-toolbar">
                <label class="table-search"><span>⌕</span><input type="search" placeholder="Search by title or ID..." aria-label="Search this collection" data-list-search /></label>
                <div class="toolbar-filters">
                  <select aria-label="Filter by status" data-status-filter><option value="">All statuses</option><option value="published">Published</option><option value="draft">Draft</option><option value="unpublished">Unpublished</option></select>
                  <select aria-label="Filter by language" data-language-filter><option value="">All languages</option><option value="complete">Both languages</option><option value="missing-en">Missing English</option><option value="missing-zh">Missing Chinese</option></select>
                  <button class="filter-button" type="button" data-action="clear-filters">↺ <span>Reset</span></button>
                </div>
              </div>
              <div class="table-wrap"><table class="admin-table library-table"><thead><tr><th><input type="checkbox" aria-label="Select all content" data-select-all /></th><th>CONTENT</th><th>LANGUAGES</th><th>CATEGORY</th><th>STATUS</th><th>FEATURED</th><th>UPDATED</th><th></th></tr></thead><tbody data-content-rows><tr><td colspan="8" class="table-loading">Loading content…</td></tr></tbody></table></div>
              <div class="table-footer"><span data-pagination-summary>—</span><div class="pagination"><button type="button" data-page-prev aria-label="Previous page">←</button><span data-page-number>1 / 1</span><button type="button" data-page-next aria-label="Next page">→</button></div></div>
            </div>
          </section>

          <section class="admin-page editor-page" data-page="editor" hidden>
            <div class="editor-topline"><button class="back-link" type="button" data-action="back-to-list">← Back to <span data-editor-back>articles</span></button><span class="editor-save-state" data-save-state>All changes saved</span></div>
            <div class="page-heading editor-heading"><div><p class="eyebrow-admin">CONTENT EDITOR</p><h1 data-editor-heading>New article</h1><p class="page-subtitle">Edit each language independently, then preview them side by side.</p></div><div class="editor-actions"><button class="secondary-button" type="button" data-action="preview">Preview</button><button class="secondary-button" type="button" data-action="save-draft">Save draft</button><button class="primary-button" type="button" data-action="publish">Publish <span>→</span></button></div></div>
            <form class="content-form" data-content-form>
              <div class="editor-languages">
                <section class="language-editor">
                  <div class="language-heading"><div class="language-title"><span class="language-badge">EN</span><div><strong>English</strong><small>Primary language</small></div></div><span class="translation-state" data-language-state="en">Not started</span></div>
                  <label>Title <span class="required">*</span><input name="title.en" required maxlength="160" placeholder="Give your story a clear title" /></label>
                  <label>Short description <span class="required">*</span><textarea name="description.en" required rows="3" maxlength="320" placeholder="A short introduction for readers and search results"></textarea></label>
                  <label>Article body <span class="required">*</span><textarea class="body-editor" name="body.en" required rows="15" placeholder="Write your article in Markdown…"></textarea><small class="field-hint">Markdown supported. Use headings, lists, links and emphasis.</small></label>
                  <div class="editor-word-count"><span data-word-count="en">0 words</span><span>English content</span></div>
                </section>
                <section class="language-editor chinese-editor">
                  <div class="language-heading"><div class="language-title"><span class="language-badge zh-badge">中文</span><div><strong>简体中文</strong><small>Translation</small></div></div><span class="translation-state is-missing" data-language-state="zh">Not started</span></div>
                  <label>标题<input name="title.zh" maxlength="160" placeholder="输入中文标题" /></label>
                  <label>简短介绍<textarea name="description.zh" rows="3" maxlength="320" placeholder="为读者和搜索结果提供简短介绍"></textarea></label>
                  <label>正文<textarea class="body-editor" name="body.zh" rows="15" placeholder="使用 Markdown 编写中文内容…"></textarea><small class="field-hint">中文内容独立保存，不会覆盖英文版本。</small></label>
                  <div class="editor-word-count"><span data-word-count="zh">0 字</span><span>中文内容</span></div>
                </section>
              </div>
              <div class="editor-lower-grid">
                <section class="panel form-panel">
                  <div class="panel-heading"><div><h2>Publishing details</h2><p>Organize and prepare this content</p></div></div>
                  <div class="form-grid">
                    <label>Content ID<input name="id" readonly placeholder="Assigned by the content service" /><small class="field-hint">Stable ID is managed by the backend.</small></label>
                    <label>URL slug<input name="slug" maxlength="120" placeholder="your-story-slug" /></label>
                    <label>Collection<select name="type"><option value="articles">Article</option><option value="lessons">Learning guide</option><option value="festivals">Festival</option><option value="books">Book</option><option value="events">Event</option></select></label>
                    <label>Category<input name="category" maxlength="80" placeholder="Arts &amp; traditions" /></label>
                    <label class="full-field">Tags<input name="tags" placeholder="calligraphy, history, art" /><small class="field-hint">Separate tags with commas.</small></label>
                    <label class="checkbox-field"><input type="checkbox" name="featured" /> <span>Feature this content on the homepage</span></label>
                    <label>Publication status<select name="status"><option value="draft">Draft</option><option value="published">Published</option><option value="unpublished">Unpublished</option></select></label>
                  </div>
                </section>
                <section class="panel form-panel seo-panel">
                  <div class="panel-heading"><div><h2>Search appearance</h2><p>SEO metadata for both languages</p></div><span class="seo-icon">⌕</span></div>
                  <label>English SEO title<input name="seoTitle.en" maxlength="70" placeholder="Search title in English" /></label>
                  <label>English meta description<textarea name="seoDescription.en" rows="2" maxlength="160" placeholder="A clear search description"></textarea></label>
                  <div class="form-divider"></div>
                  <label>中文 SEO 标题<input name="seoTitle.zh" maxlength="70" placeholder="中文搜索标题" /></label>
                  <label>中文 Meta 描述<textarea name="seoDescription.zh" rows="2" maxlength="160" placeholder="中文搜索摘要"></textarea></label>
                  <div class="form-divider"></div>
                  <label>Cover image URL<input name="coverImage" placeholder="Select an image from Media Library" /></label>
                  <button class="text-button media-select-button" type="button" data-action="open-media">Choose from media library →</button>
                </section>
              </div>
              <div class="editor-bottom-actions"><button class="danger-text-button" type="button" data-action="delete-current" hidden>Delete content</button><span>Changes are not public until published.</span><div><button class="secondary-button" type="button" data-action="preview">Preview</button><button class="secondary-button" type="button" data-action="save-draft">Save draft</button><button class="primary-button" type="button" data-action="publish">Publish →</button></div></div>
            </form>
          </section>

          <section class="admin-page" data-page="homepage" hidden>
            <div class="page-heading"><div><p class="eyebrow-admin">SITE PRESENTATION</p><h1>Homepage management</h1><p class="page-subtitle">Curate the stories and learning paths visitors see first.</p></div><button class="primary-button" type="button" data-action="save-settings">Save changes</button></div>
            <div class="settings-grid">
              <section class="panel form-panel"><div class="panel-heading"><div><h2>Hero content</h2><p>First impression on the homepage</p></div></div><label>English headline<input value="A culture with a thousand doorways. Find yours." /></label><label>Chinese headline<input placeholder="中文首页标题" /></label><label>English introduction<textarea rows="3">Discover Chinese culture through clear, thoughtful guides.</textarea></label><label>中文介绍<textarea rows="3" placeholder="中文首页介绍"></textarea></label></section>
              <section class="panel form-panel"><div class="panel-heading"><div><h2>Featured collections</h2><p>Choose what to spotlight</p></div></div><div class="setting-row"><span><strong>Featured articles</strong><small>Show selected stories on the homepage</small></span><input type="checkbox" checked /></div><div class="setting-row"><span><strong>Learning path</strong><small>Highlight the beginner curriculum</small></span><input type="checkbox" checked /></div><div class="setting-row"><span><strong>Festival spotlight</strong><small>Show a seasonal festival guide</small></span><input type="checkbox" checked /></div><div class="setting-row"><span><strong>Books and reading</strong><small>Feature reading recommendations</small></span><input type="checkbox" checked /></div></section>
            </div>
          </section>

          <section class="admin-page" data-page="settings" hidden>
            <div class="page-heading"><div><p class="eyebrow-admin">SITE CONFIGURATION</p><h1>Navigation &amp; settings</h1><p class="page-subtitle">Manage site identity, navigation labels and global preferences.</p></div><button class="primary-button" type="button" data-action="save-settings">Save changes</button></div>
            <div class="settings-grid">
              <section class="panel form-panel"><div class="panel-heading"><div><h2>Site identity</h2><p>Public site information</p></div></div><label>Site name<input value="Chinese Culture Atlas" /></label><label>Short description<textarea rows="3" placeholder="A short description of the site"></textarea></label><label>Default language<select><option>English</option><option>简体中文</option></select></label><label>Public website URL<input value="https://chinese-culture.site" /></label></section>
              <section class="panel form-panel"><div class="panel-heading"><div><h2>Primary navigation</h2><p>Visible links in the public website</p></div><button class="text-button" type="button" data-action="add-navigation">＋ Add link</button></div><div class="navigation-list"><div><span class="drag-handle">⠿</span><strong>Learn</strong><small>/learn/</small><span class="nav-visible">Visible</span></div><div><span class="drag-handle">⠿</span><strong>Culture</strong><small>/culture/</small><span class="nav-visible">Visible</span></div><div><span class="drag-handle">⠿</span><strong>Festivals</strong><small>/festivals/</small><span class="nav-visible">Visible</span></div><div><span class="drag-handle">⠿</span><strong>Books</strong><small>/books/</small><span class="nav-visible">Visible</span></div><div><span class="drag-handle">⠿</span><strong>Events</strong><small>/events/</small><span class="nav-visible">Visible</span></div></div></section>
            </div>
          </section>

          <section class="admin-page" data-page="media" hidden>
            <div class="page-heading"><div><p class="eyebrow-admin">ASSET LIBRARY</p><h1>Media library</h1><p class="page-subtitle">Upload and organize approved images for your stories.</p></div><div class="editor-actions"><button class="secondary-button" type="button" data-action="back-to-editor" hidden>← Back to editor</button><button class="primary-button" type="button" data-action="choose-upload">＋ Upload media</button></div></div>
            <section class="panel media-panel">
              <label class="upload-dropzone" data-dropzone><input type="file" accept="image/png,image/jpeg,image/webp,image/avif" multiple data-media-input hidden /><span class="upload-icon">↑</span><strong>Drop images here, or <u>browse files</u></strong><small>PNG, JPG, WebP or AVIF · Maximum size depends on media service policy</small></label>
              <div class="media-toolbar"><span data-media-count>Media assets</span><label class="table-search"><span>⌕</span><input type="search" placeholder="Search media..." data-media-search /></label><select aria-label="Filter media type"><option>All media</option><option>Images</option></select></div>
              <div class="media-grid" data-media-grid><div class="media-empty"><span>▧</span><strong>Your media library is ready</strong><p>Uploaded assets will appear here after the media API is connected.</p></div></div>
            </section>
          </section>

          <section class="admin-page" data-page="languages" hidden>
            <div class="page-heading"><div><p class="eyebrow-admin">LOCALIZATION</p><h1>Language management</h1><p class="page-subtitle">Track translation coverage and keep both editions in sync.</p></div><button class="primary-button" type="button" data-action="save-settings">Save language settings</button></div>
            <div class="stats-grid language-stats"><article class="stat-card"><div class="stat-top"><span>Default language</span><span class="language-badge">EN</span></div><strong>English</strong><small>Primary editorial source</small></article><article class="stat-card"><div class="stat-top"><span>Available languages</span><span class="language-badge zh-badge">中文</span></div><strong>2</strong><small>English · 简体中文</small></article><article class="stat-card"><div class="stat-top"><span>Translation coverage</span><span class="stat-icon icon-green">文</span></div><strong data-stat="coverage">—</strong><small>Content with both versions</small></article><article class="stat-card"><div class="stat-top"><span>Needs attention</span><span class="stat-icon icon-amber">!</span></div><strong data-stat="missing">—</strong><small>Incomplete language pairs</small></article></div>
            <section class="panel language-panel"><div class="panel-heading"><div><h2>Translation overview</h2><p>Content completeness by collection</p></div></div><div class="table-wrap"><table class="admin-table"><thead><tr><th>COLLECTION</th><th>ENGLISH</th><th>中文</th><th>COMPLETE PAIRS</th><th>NEEDS WORK</th></tr></thead><tbody data-language-rows><tr><td colspan="5" class="table-loading">Loading translation status…</td></tr></tbody></table></div></section>
          </section>
        </main>
        <footer class="admin-footer"><span>Chinese Culture Atlas · Editorial Studio</span><span>Admin workspace <i>•</i> <span data-connection-status>Checking connection</span></span></footer>
      </div>
    </div>

    <dialog class="preview-dialog" data-preview-dialog>
      <div class="dialog-header"><div><p class="eyebrow-admin">CONTENT PREVIEW</p><h2>Reader preview</h2></div><button class="icon-button" type="button" data-action="close-preview" aria-label="Close preview">×</button></div>
      <div class="preview-language-switch"><button type="button" class="is-selected" data-preview-language="en">English</button><button type="button" data-preview-language="zh">简体中文</button><span data-preview-language-status></span></div>
      <article class="reader-preview"><p class="preview-category" data-preview-category>Culture</p><h1 data-preview-title>Untitled story</h1><p class="preview-description" data-preview-description></p><div class="preview-body" data-preview-body></div></article>
    </dialog>
    <dialog class="confirm-dialog" data-confirm-dialog>
      <div class="confirm-symbol">!</div><h2>Delete this content?</h2><p>This action cannot be undone. The content will be removed from the editorial library.</p><div class="confirm-actions"><button class="secondary-button" type="button" data-action="cancel-delete">Cancel</button><button class="danger-button" type="button" data-action="confirm-delete">Delete content</button></div>
    </dialog>
    <div class="toast-region" aria-live="polite" aria-atomic="true" data-toast-region></div>
    <script>import("../../scripts/admin.mjs");</script>
  </body>
</html>
