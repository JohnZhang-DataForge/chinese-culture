---
import "../../styles/admin.css";
const demo = import.meta.env.DEV;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#172b27" />
    <title>Admin · Chinese Culture Atlas</title>
    <meta name="description" content="Private administration workspace for Chinese Culture Atlas." />
  </head>
  <body class="admin-body">
    <div class="admin-shell" data-admin-app data-demo={demo ? "true" : "false"}>
      <aside class="admin-sidebar" id="admin-sidebar" aria-label="Admin navigation">
        <a class="admin-brand" href="/admin/" aria-label="Chinese Culture Atlas admin home">
          <span class="admin-brand-mark" aria-hidden="true">文</span>
          <span class="admin-brand-copy"><strong>Culture Atlas</strong><small>EDITORIAL STUDIO</small></span>
        </a>
        <div class="sidebar-divider"></div>
        <p class="sidebar-label">WORKSPACE</p>
        <nav class="admin-nav" aria-label="Workspace">
          <button class="nav-item is-active" type="button" data-nav="dashboard"><span class="nav-icon">◫</span><span>Overview</span></button>
          <button class="nav-item" type="button" data-nav="articles"><span class="nav-icon">▤</span><span>Articles</span><span class="nav-count" data-count="articles">—</span></button>
          <button class="nav-item" type="button" data-nav="lessons"><span class="nav-icon">▧</span><span>Learning guides</span><span class="nav-count" data-count="lessons">—</span></button>
          <button class="nav-item" type="button" data-nav="festivals"><span class="nav-icon">✳</span><span>Festivals</span><span class="nav-count" data-count="festivals">—</span></button>
          <button class="nav-item" type="button" data-nav="books"><span class="nav-icon">▥</span><span>Books</span><span class="nav-count" data-count="books">—</span></button>
          <button class="nav-item" type="button" data-nav="events"><span class="nav-icon">◷</span><span>Events</span><span class="nav-count" data-count="events">—</span></button>
        </nav>
        <p class="sidebar-label sidebar-label-spaced">SITE MANAGEMENT</p>
        <nav class="admin-nav" aria-label="Site management">
          <button class="nav-item" type="button" data-nav="homepage"><span class="nav-icon">⌂</span><span>Homepage</span></button>
          <button class="nav-item" type="button" data-nav="settings"><span class="nav-icon">⚙</span><span>Navigation &amp; settings</span></button>
          <button class="nav-item" type="button" data-nav="media" disabled title="Global media library is not in the approved API contract"><span class="nav-icon">▧</span><span>Media library · later</span></button>
          <button class="nav-item" type="button" data-nav="languages"><span class="nav-icon">文</span><span>Languages</span></button>
        </nav>
        <div class="sidebar-bottom">
          <div class="sidebar-help"><span class="help-icon">?</span><div><strong>Need a hand?</strong><small>Editorial workspace guide</small></div><span aria-hidden="true">↗</span></div>
          <div class="admin-profile"><span class="profile-avatar">E</span><span><strong data-session-email>Editorial team</strong><small data-session-role>Administrator</small></span><span class="profile-menu" aria-hidden="true">•••</span></div>
        </div>
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <div class="topbar-left">
            <button class="icon-button mobile-menu-button" type="button" data-action="toggle-sidebar" aria-label="Open navigation">☰</button>
            <div class="breadcrumbs"><span>Workspace</span><span class="crumb-slash">/</span><strong data-breadcrumb>Overview</strong></div>
          </div>
          <div class="topbar-actions">
            <label class="global-search"><span aria-hidden="true">⌕</span><input type="search" placeholder="Search content..." aria-label="Search content" data-global-search /><kbd>⌘ K</kbd></label>
            <a class="topbar-site-link" href="/" target="_blank" rel="noreferrer">View website <span aria-hidden="true">↗</span></a>
            <button class="icon-button notification-button" type="button" aria-label="Notifications"><span aria-hidden="true">♧</span><i></i></button>
            <span class="topbar-avatar" aria-label="Editorial team">E</span>
          </div>
        </header>

        <main class="admin-content">
          <div class="admin-connection-banner" data-admin-banner role="status" aria-live="polite" hidden></div>
          <section class="admin-page" data-page="dashboard">
            <div class="page-heading">
              <div><p class="eyebrow-admin">THURSDAY, NOVEMBER 5</p><h1>Good morning, editor.</h1><p class="page-subtitle">Here’s what’s happening across your culture library.</p></div>
              <button class="primary-button" type="button" data-action="new-content"><span>＋</span> Create content</button>
            </div>
            <div class="stats-grid">
              <article class="stat-card"><div class="stat-top"><span>Total content</span><span class="stat-icon icon-jade">▤</span></div><strong data-stat="total">—</strong><small><span class="stat-neutral">Across all collections</span></small></article>
              <article class="stat-card"><div class="stat-top"><span>Published</span><span class="stat-icon icon-green">↗</span></div><strong data-stat="published">—</strong><small><span class="stat-positive">Live on your website</span></small></article>
              <article class="stat-card"><div class="stat-top"><span>Drafts</span><span class="stat-icon icon-amber">✎</span></div><strong data-stat="drafts">—</strong><small><span class="stat-neutral">Waiting for review</span></small></article>
              <article class="stat-card"><div class="stat-top"><span>Traditional Chinese articles</span><span class="stat-icon icon-red">文</span></div><strong data-stat="translations">—</strong><small><span class="stat-neutral">Single authored language</span></small></article>
            </div>
            <div class="dashboard-grid">
              <article class="panel recent-panel">
                <div class="panel-heading"><div><h2>Recently updated</h2><p>Your latest editorial activity</p></div><button class="text-button" type="button" data-action="open-articles">View all <span>→</span></button></div>
                <div class="table-wrap"><table class="admin-table"><thead><tr><th>CONTENT</th><th>COLLECTION</th><th>STATUS</th><th>UPDATED</th><th></th></tr></thead><tbody data-recent-rows><tr><td colspan="5" class="table-loading">Loading content workspace…</td></tr></tbody></table></div>
              </article>
              <article class="panel activity-panel">
                <div class="panel-heading"><div><h2>Editorial checklist</h2><p>Keep the library in good shape</p></div><span class="checklist-count">4 tasks</span></div>
                <div class="checklist">
                  <div class="check-row"><span class="check-circle">✓</span><span><strong>Review new submissions</strong><small>Check drafts before publishing</small></span><span class="check-arrow">→</span></div>
                  <div class="check-row"><span class="check-circle check-pending"></span><span><strong>Review content</strong><small>Maintain Traditional Chinese editorial quality</small></span><span class="check-arrow">→</span></div>
                  <div class="check-row"><span class="check-circle check-pending"></span><span><strong>Check featured stories</strong><small>Refresh the homepage spotlight</small></span><span class="check-arrow">→</span></div>
                  <div class="check-row"><span class="check-circle check-pending"></span><span><strong>Review media descriptions</strong><small>Add meaningful alt text</small></span><span class="check-arrow">→</span></div>
                </div>
              </article>
            </div>
            <div class="welcome-strip"><div class="welcome-mark">文</div><div><strong>A thoughtful library starts with good stories.</strong><p>Write with context, respect regional differences, and keep sources close at hand.</p></div><a href="/editorial-policy/" target="_blank" rel="noreferrer">Editorial principles ↗</a></div>
          </section>

          <section class="admin-page" data-page="content" hidden>
            <div class="page-heading">
              <div><p class="eyebrow-admin">CONTENT LIBRARY</p><h1 data-content-heading>Articles</h1><p class="page-subtitle" data-content-subtitle>Manage stories, metadata and publication status.</p></div>
              <button class="primary-button" type="button" data-action="new-content"><span>＋</span> New <span data-new-label>article</span></button>
            </div>
            <div class="panel library-panel">
              <div class="library-toolbar">
                <label class="table-search"><span>⌕</span><input type="search" placeholder="Search by title or ID..." aria-label="Search this collection" data-list-search /></label>
                <div class="toolbar-filters">
                  <select aria-label="Filter by status" data-status-filter><option value="">All statuses</option><option value="published">Published</option><option value="draft">Draft</option><option value="unpublished">Unpublished</option></select>
                  <select aria-label="Filter by language" data-language-filter><option value="">All languages</option><option value="">繁體中文</option></select>
                  <button class="filter-button" type="button" data-action="clear-filters">↺ <span>Reset</span></button>
                </div>
              </div>
              <div class="table-wrap"><table class="admin-table library-table"><thead><tr><th><input type="checkbox" aria-label="Select all content" data-select-all /></th><th>CONTENT</th><th>語言</th><th>CATEGORY</th><th>STATUS</th><th>FEATURED</th><th>UPDATED</th><th></th></tr></thead><tbody data-content-rows><tr><td colspan="8" class="table-loading">Loading content…</td></tr></tbody></table></div>
              <div class="table-footer"><span data-pagination-summary>—</span><div class="pagination"><button type="button" data-page-prev aria-label="Previous page">←</button><span data-page-number>1 / 1</span><button type="button" data-page-next aria-label="Next page">→</button></div></div>
            </div>
          </section>

          <section class="admin-page editor-page" data-page="editor" hidden>
            <div class="editor-topline"><button class="back-link" type="button" data-action="back-to-list">← Back to <span data-editor-back>articles</span></button><span class="editor-save-state" data-save-state>All changes saved</span><a class="pr-status-link" data-pr-link hidden target="_blank" rel="noreferrer">View review PR ↗</a></div>
            <div class="page-heading editor-heading"><div><p class="eyebrow-admin">CONTENT EDITOR</p><h1 data-editor-heading>New article</h1><p class="page-subtitle">以繁體中文編輯文章，預覽後再提交審核。</p></div><div class="editor-actions"><button class="secondary-button" type="button" data-action="preview">Preview</button><button class="secondary-button" type="button" data-action="save-draft">Save draft</button><button class="primary-button" type="button" data-action="publish">Request publish <span>→</span></button><button class="danger-button" type="button" data-action="unpublish" hidden>Request unpublish</button></div></div>
            <form class="content-form" data-content-form>
              <div class="editor-languages"><section class="language-editor chinese-editor">
                  <div class="language-heading"><div class="language-title"><span class="language-badge zh-badge">中文</span><div><strong>繁體中文</strong><small>唯一正式內容語言</small></div></div><span class="translation-state is-missing" data-language-state="zh">Not started</span></div>
                  <label>標題<input name="title.zh" maxlength="180" placeholder="輸入文章標題" /></label>
                  <label>URL slug<input name="slug.zh" maxlength="120" placeholder="wenhua-gushi" /></label>
                  <label>簡短介紹<textarea name="description.zh" rows="3" maxlength="500" placeholder="为读者和搜索结果提供簡短介紹"></textarea></label>
                  <label>分類<input name="category.zh" maxlength="100" placeholder="文化与传统" /></label>
                  <label>標籤<input name="tags.zh" maxlength="800" placeholder="书法、历史、艺术" /><small class="field-hint">以逗號分隔。</small></label>
                  <label>正文<textarea class="body-editor" name="body.zh" rows="15" maxlength="200000" placeholder="使用 Markdown 编写繁體中文內容…"></textarea><small class="field-hint">內容以繁體中文保存。</small></label>
                  <div class="form-grid variant-meta"><label>閱讀時間（分鐘）<input type="number" name="readingMinutes.zh" min="1" max="240" value="5" /></label><label>學習程度<input name="level.zh" maxlength="80" placeholder="入门" /></label></div>
                  <label class="checkbox-field variant-feature"><input type="checkbox" name="featured.zh" /> <span>在首頁推薦此文章</span></label>
                  <details class="variant-details"><summary>現有封面圖片</summary><label>圖片網址<input name="imageUrl.zh" type="url" placeholder="https://…" /></label><label>替代文字<input name="imageAlt.zh" maxlength="300" placeholder="描述圖片內容" /></label></details><details class="variant-details"><summary>上傳新圖片與授權資訊</summary><label>圖片路徑<input name="mediaSrc.zh" placeholder="/media/content-id/image.webp" /></label><label>替代文字<input name="mediaAlt.zh" maxlength="300" placeholder="描述圖片內容，方便輔助科技理解" /></label><label>圖片來源<input name="mediaCredit.zh" maxlength="300" placeholder="攝影者或來源" /></label><label>授權方式<input name="mediaLicense.zh" maxlength="160" placeholder="原创、CC BY 4.0、已取得授權…" /></label><label>來源網址<input name="mediaSource.zh" type="url" placeholder="https://…" /></label><div class="variant-media-list" data-variant-media-list="zh"></div><button class="secondary-button" type="button" data-action="upload-variant-media" data-locale="zh-TW">上傳圖片至繁體中文文章</button><input type="file" accept="image/png,image/jpeg,image/webp,image/avif" data-variant-media-input="zh-TW" hidden /></details>
                  <div class="editor-word-count"><span data-word-count="zh">0 字</span><span>繁體中文內容</span></div>
                </section></div>
              <div class="editor-lower-grid">
                <section class="panel form-panel">
                  <div class="panel-heading"><div><h2>Publishing details</h2><p>Organize and prepare this content</p></div></div>
                  <div class="form-grid">
                    <label class="full-field">Content ID<input name="id" readonly placeholder="Assigned by the content service" /><small class="field-hint">Stable ID is immutable and managed by the backend.</small></label>
                    <label class="full-field">Collection<select name="type"><option value="articles">Article (culture)</option><option value="lessons">Learning guide</option><option value="festivals">Festival</option><option value="books">Book</option><option value="events">Event</option></select></label>
                    <p class="field-hint full-field">Tags are stored independently with each language variant.</p>
                    <label>Publication workflow<select name="status" disabled><option value="draft">Save creates a draft</option><option value="published">Publish through a review PR</option><option value="unpublished">Unpublish through a review PR</option></select><small class="field-hint">Publishing never merges a pull request automatically.</small></label>
                  </div>
                </section>
                <section class="panel form-panel seo-panel">
                  <div class="panel-heading"><div><h2>Search appearance</h2><p>繁體中文搜尋引擎資訊</p></div><span class="seo-icon">⌕</span></div>
                  <label>SEO 標題<input name="seoTitle.zh" maxlength="180" placeholder="繁體中文搜尋標題" /></label>
                  <label>Meta 描述<textarea name="seoDescription.zh" rows="2" maxlength="300" placeholder="繁體中文搜尋摘要"></textarea></label>
                  <div class="form-divider"></div>
                  <p class="field-hint contract-note">Uploads attach images to a selected content variant. A global searchable media library still needs a listing API.</p>
                  <p class="field-hint">Upload and select images inside each language panel. The global media library is not available yet.</p>
                </section>
              </div>
              <div class="editor-bottom-actions"><button class="danger-text-button" type="button" data-action="delete-current" hidden>Discard draft</button><span>Changes become public only after the review pull request is merged.</span><div><button class="secondary-button" type="button" data-action="preview">Preview</button><button class="secondary-button" type="button" data-action="save-draft">Save draft</button><button class="primary-button" type="button" data-action="publish">Request publish →</button><button class="danger-button" type="button" data-action="unpublish" hidden>Request unpublish</button></div></div>
            </form>
          </section>

          <section class="admin-page" data-page="homepage" hidden>
            <div class="page-heading"><div><p class="eyebrow-admin">SITE PRESENTATION</p><h1>Homepage management</h1><p class="page-subtitle">Curate the stories and learning paths visitors see first.</p></div><button class="primary-button" type="button" data-action="save-settings" disabled>Save changes</button></div><div class="admin-connection-banner">Read-only until Agent 0 adds the homepage settings API to the approved contract.</div>
            <div class="settings-grid">
              <section class="panel form-panel"><div class="panel-heading"><div><h2>Hero content</h2><p>First impression on the homepage</p></div></div><label>首頁標題<input placeholder="輸入繁體中文首頁標題" /></label><label>首頁介紹<textarea rows="3" placeholder="輸入繁體中文首頁介紹"></textarea></label></section>
              <section class="panel form-panel"><div class="panel-heading"><div><h2>Featured collections</h2><p>Choose what to spotlight</p></div></div><div class="setting-row"><span><strong>Featured articles</strong><small>Show selected stories on the homepage</small></span><input type="checkbox" checked /></div><div class="setting-row"><span><strong>Learning path</strong><small>Highlight the beginner curriculum</small></span><input type="checkbox" checked /></div><div class="setting-row"><span><strong>Festival spotlight</strong><small>Show a seasonal festival guide</small></span><input type="checkbox" checked /></div><div class="setting-row"><span><strong>Books and reading</strong><small>Feature reading recommendations</small></span><input type="checkbox" checked /></div></section>
            </div>
          </section>

          <section class="admin-page" data-page="settings" hidden>
            <div class="page-heading"><div><p class="eyebrow-admin">SITE CONFIGURATION</p><h1>Navigation &amp; settings</h1><p class="page-subtitle">Manage site identity, navigation labels and global preferences.</p></div><button class="primary-button" type="button" data-action="save-settings" disabled>Save changes</button></div><div class="admin-connection-banner">Read-only until the navigation and site-settings endpoints are included in the approved API contract.</div>
            <div class="settings-grid">
              <section class="panel form-panel"><div class="panel-heading"><div><h2>Site identity</h2><p>Public site information</p></div></div><label>Site name<input value="Chinese Culture Atlas" /></label><label>Short description<textarea rows="3" placeholder="A short description of the site"></textarea></label><label>預設語言<input value="繁體中文" readonly /></label><label>Public website URL<input value="https://chinese-culture.site" /></label></section>
              <section class="panel form-panel"><div class="panel-heading"><div><h2>Primary navigation</h2><p>Visible links in the public website</p></div><button class="text-button" type="button" data-action="add-navigation" disabled>＋ Add link</button></div><div class="navigation-list"><div><span class="drag-handle">⠿</span><strong>Learn</strong><small>/learn/</small><span class="nav-visible">Visible</span></div><div><span class="drag-handle">⠿</span><strong>Culture</strong><small>/culture/</small><span class="nav-visible">Visible</span></div><div><span class="drag-handle">⠿</span><strong>Festivals</strong><small>/festivals/</small><span class="nav-visible">Visible</span></div><div><span class="drag-handle">⠿</span><strong>Books</strong><small>/books/</small><span class="nav-visible">Visible</span></div><div><span class="drag-handle">⠿</span><strong>Events</strong><small>/events/</small><span class="nav-visible">Visible</span></div></div></section>
            </div>
          </section>

          <section class="admin-page" data-page="media" hidden>
            <div class="page-heading"><div><p class="eyebrow-admin">ASSET LIBRARY</p><h1>Media library</h1><p class="page-subtitle">Upload and organize approved images for your stories.</p></div><div class="editor-actions"><button class="secondary-button" type="button" data-action="back-to-editor" hidden>← Back to editor</button><button class="primary-button" type="button" data-action="choose-upload" disabled>＋ Upload media</button></div></div>
            <section class="panel media-panel">
              <label class="upload-dropzone" data-dropzone><input type="file" accept="image/png,image/jpeg,image/webp,image/avif" multiple data-media-input hidden disabled /><span class="upload-icon">↑</span><strong>Drop images here, or <u>browse files</u></strong><small>PNG, JPG, WebP or AVIF · Maximum size depends on media service policy</small></label>
              <div class="media-toolbar"><span data-media-count>Media assets</span><label class="media-locale-label">內容語言 <select data-media-locale aria-label="內容語言"><option value="zh-TW">繁體中文</option></select></label><label class="table-search"><span>⌕</span><input type="search" placeholder="Search media..." data-media-search /></label><select aria-label="Filter media type"><option>All media</option><option>Images</option></select></div>
              <p class="field-hint contract-note" data-media-contract-note>Existing media search/listing is not yet in the API contract. Uploads will attach to the selected content and language.</p><div class="media-grid" data-media-grid><div class="media-empty"><span>▧</span><strong>Choose a content item to manage its images</strong><p>Media is stored with the selected locale variant.</p></div></div>
            </section>
          </section>

          <section class="admin-page" data-page="languages" hidden>
            <div class="page-heading"><div><p class="eyebrow-admin">LOCALIZATION</p><h1>內容語言</h1><p class="page-subtitle">網站只維護繁體中文原創內容；訪客可嘗試使用 Google 翻譯。</p></div><button class="primary-button" type="button" data-action="save-settings">Save language settings</button></div>
            <div class="stats-grid language-stats"><article class="stat-card"><div class="stat-top"><span>預設語言</span><span class="language-badge zh-badge">繁中</span></div><strong>繁體中文</strong><small>唯一正式內容語言</small></article><article class="stat-card"><div class="stat-top"><span>正式語言</span><span class="language-badge zh-badge">繁中</span></div><strong>1</strong><small>僅維護繁體中文</small></article><article class="stat-card"><div class="stat-top"><span>內容完整度</span><span class="stat-icon icon-green">文</span></div><strong data-stat="coverage">—</strong><small>繁體中文內容</small></article><article class="stat-card"><div class="stat-top"><span>待處理內容</span><span class="stat-icon icon-amber">!</span></div><strong data-stat="missing">—</strong><small>尚未完成的文章</small></article></div>
            <section class="panel language-panel"><div class="panel-heading"><div><h2>內容概覽</h2><p>各分類的繁體中文文章數量</p></div></div><div class="table-wrap"><table class="admin-table"><thead><tr><th>分類</th><th>繁體中文文章數</th></tr></thead><tbody data-language-rows><tr><td colspan="2" class="table-loading">正在載入內容…</td></tr></tbody></table></div></section>
          </section>
        </main>
        <footer class="admin-footer"><span>Chinese Culture Atlas · Editorial Studio</span><span>Admin workspace <i>•</i> <span data-connection-status>Checking connection</span></span></footer>
      </div>
    </div>

    <dialog class="preview-dialog" data-preview-dialog>
      <div class="dialog-header"><div><p class="eyebrow-admin">CONTENT PREVIEW</p><h2>Reader preview</h2></div><button class="icon-button" type="button" data-action="close-preview" aria-label="Close preview">×</button></div>
      <div class="preview-language-switch"><span>繁體中文預覽</span><span data-preview-language-status></span></div>
      <article class="reader-preview"><p class="preview-category" data-preview-category>Culture</p><h1 data-preview-title>Untitled story</h1><p class="preview-description" data-preview-description></p><iframe class="preview-frame" data-preview-frame sandbox title="Sanitized article preview" hidden></iframe><div class="preview-body" data-preview-body></div></article>
    </dialog>
    <dialog class="confirm-dialog" data-confirm-dialog>
      <div class="confirm-symbol">!</div><h2>Delete this content?</h2><p>This discards only an unsubmitted draft variant. Published content must be unpublished through a reviewed pull request.</p><div class="confirm-actions"><button class="secondary-button" type="button" data-action="cancel-delete">Cancel</button><button class="danger-button" type="button" data-action="confirm-delete">Discard draft</button></div>
    </dialog>
    <div class="toast-region" aria-live="polite" aria-atomic="true" data-toast-region></div>
    <script>import("../../scripts/admin.mjs");</script>
  </body>
</html>
