---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Events" description="Cultural event announcements, verified with organizers before publication.">
  <section class="page-hero"><div class="wrap"><span class="eyebrow">Gather and learn</span><h1>Culture is something we share.</h1><p class="lead">Exhibitions, talks, workshops and celebrations can bring a story off the page and into everyday life.</p></div></section>
  <section class="section"><div class="wrap">
    <div class="empty-state"><span class="eyebrow">Upcoming events</span><h2>No verified events listed yet.</h2><p>We're establishing an editorial process to check dates, organizers, location details and registration links before posting announcements. We won't publish invented or outdated events.</p><p><a class="button" href="/festivals/">Explore festival traditions ↗</a></p></div>
  </div></section>
</BaseLayout>
