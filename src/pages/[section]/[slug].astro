---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { sections } from "../../lib/sections";

export async function getStaticPaths() {
  const grouped=await Promise.all(sections.map(async (config)=>{
    const entries=await getCollection(config.collection);
    return entries.filter((entry)=>(entry.data.status ?? "published")==="published")
      .map((entry)=>({params:{section:config.route,slug:entry.id},props:{entry,config}}));
  }));
  return grouped.flat();
}
const {entry,config}=Astro.props;
const {Content}=await render(entry);
const inSection=(await getCollection(config.collection))
  .filter((item)=>(item.data.status ?? "published")==="published")
  .sort((a,b)=>(a.data.order??99)-(b.data.order??99) || a.data.title.localeCompare(b.data.title));
const related=inSection.filter((other)=>other.id!==entry.id).slice(0,3);
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <header class="entry-hero"><div class="wrap">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={"/"+config.route+"/"}>{config.nav}</a><span aria-hidden="true">/</span><span>{entry.data.title}</span></nav>
    <span class="eyebrow">{entry.data.category}</span>
    {entry.data.chinese && <div class="entry-chinese" lang="zh-Hans">{entry.data.chinese}</div>}
    <h1>{entry.data.title}</h1><p class="lead">{entry.data.description}</p>
    <div class="entry-meta"><span>{entry.data.readingMinutes} min read</span>{entry.data.level && <span>{entry.data.level}</span>}<span>Original learning guide</span></div>
  </div></header>
  {entry.data.image && <div class="article-cover wrap"><img src={entry.data.image} alt={entry.data.imageAlt ?? entry.data.title} fetchpriority="high" /></div>}
  <div class="wrap article-layout">
    <article class="prose"><Content /><hr /><p><a href={"/"+config.route+"/"}>← Back to {config.nav.toLowerCase()}</a></p></article>
    <aside class="article-aside" aria-label="Continue exploring"><h2>Keep exploring</h2><p>Follow another thread and see where it takes you.</p><ul>{related.map((item)=><li><a href={"/"+config.route+"/"+item.id+"/"}>{item.data.title} ↗</a></li>)}</ul><p><a href="/editorial-policy/">Our editorial approach</a></p></aside>
  </div>
</BaseLayout>
