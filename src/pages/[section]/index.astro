---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StoryCard from "../../components/StoryCard.astro";
import { getCollection } from "astro:content";
import { sections } from "../../lib/sections";
export function getStaticPaths(){return sections.map((config)=>({params:{section:config.route},props:{config}}));}
const {config}=Astro.props;
const entries=(await getCollection(config.collection)).filter((entry)=>(entry.data.status??"published")==="published");
---
<BaseLayout title={config.nav} description={config.description}>
  <section class="page-hero-plain"><div class="wrap"><span class="eyebrow">{config.eyebrow}</span><h1>{config.title}</h1><p class="lead">{config.description}</p></div></section>
  <section class="section collection-grid"><div class="wrap"><p class="index-note">{config.note} · {entries.length} guides available.</p>
    {entries.length?<div class="cards">{entries.map((entry,i)=><StoryCard href={"/"+config.route+"/"+entry.id+"/"} title={entry.data.title} description={entry.data.description} category={entry.data.category} readingMinutes={entry.data.readingMinutes} chinese={entry.data.chinese} number={i+1}/>)}</div>:<div class="empty-state"><h2>No articles have been published yet.</h2></div>}
  </div></section>
</BaseLayout>
