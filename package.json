{
  "name": "chinese-culture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "verify": "node scripts/verify-static.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:openapi": "node scripts/validate-openapi-contract.mjs",
    "lint:openapi": "npx --yes @redocly/cli@1.34.5 lint --extends=recommended docs/openspec/contracts/admin-api.openapi.yaml",
    "deploy": "npm run build && npm run verify && wrangler pages deploy dist --project-name=chinese-culture --branch=main",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "wrangler": "^4.34.0",
    "@playwright/test": "1.56.1"
  }
}
