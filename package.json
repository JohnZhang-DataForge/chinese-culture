{
  "name": "chinese-culture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "verify": "node scripts/verify-static.mjs",
    "deploy": "npm run build && wrangler deploy",
    "build:worker": "node scripts/build-embedded-worker.mjs",
    "test:worker": "node scripts/test-embedded-worker.mjs",
    "deploy:embedded": "npm run build && npm run verify && npm run build:worker && npm run test:worker && wrangler deploy --config wrangler.embedded.jsonc"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "wrangler": "^4.34.0"
  }
}
