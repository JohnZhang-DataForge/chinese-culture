{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chinese-culture",
  "compatibility_date": "2026-11-04",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "chinese-culture-cms",
      "database_id": "8b6f6c98-06fe-49eb-adbc-690d4b57c058",
      "migrations_dir": "database/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "ADMIN_ORIGIN": "https://chinese-culture.site",
    "ADMIN_EMAIL": "yanbo.zhang2035@gmail.com",
    "CF_ACCESS_TEAM_DOMAIN": "https://yanbozhang.cloudflareaccess.com",
    "CF_ACCESS_AUD": "423a232208f3f583ae948e9215672387dce2bd2235202f841bfba263d9cb2168",
    "GITHUB_APP_ID": "5712195",
    "GITHUB_INSTALLATION_ID": "180887271"
  }
}
